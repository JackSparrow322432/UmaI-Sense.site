diff --git a/umaisense-back-main/src/utils/documentText.ts b/umaisense-back-main/src/utils/documentText.ts
new file mode 100644
index 0000000..5aefe20
--- /dev/null
+++ b/umaisense-back-main/src/utils/documentText.ts
@@ -0,0 +1,190 @@
+import fs from 'fs/promises';
+import os from 'os';
+import path from 'path';
+import { execFile } from 'child_process';
+import { promisify } from 'util';
+import mammoth from 'mammoth';
+import DocumentModel from '../models/Document';
+import { downloadStored, isProviderAvailable, StorageProvider } from './documentStorage';
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const WordExtractor = require('word-extractor');
+
+const run = promisify(execFile);
+
+/**
+ * Расшифровка документов — извлечение текста. Работает ТОЛЬКО на нашем сервере в РК:
+ * файлы никуда не отправляются (никаких внешних ИИ/облачных OCR).
+ *
+ *  • PDF с текстовым слоем — pdftotext (poppler);
+ *  • сканы (PDF без текста, JPEG/PNG/HEIC) — распознавание tesseract (рус, каз, англ);
+ *  • Word .docx — mammoth, .doc — word-extractor.
+ *
+ * Результат сохраняется в документе (extractedText), чтобы не распознавать повторно.
+ */
+
+export type ExtractMethod = 'text' | 'ocr' | 'word' | 'none';
+export type Extracted = { text: string; method: ExtractMethod; pages?: number; error?: string };
+
+const MAX_OCR_PAGES = Number(process.env.OCR_MAX_PAGES) || 15;
+const OCR_TIMEOUT_MS = 120_000;
+const MAX_TEXT = 400_000; // символов на документ
+
+let langsCache: string | null = null;
+/** Языки распознавания, которые реально установлены на сервере */
+const ocrLangs = async (): Promise<string | null> => {
+  if (langsCache !== null) return langsCache || null;
+  try {
+    const { stdout, stderr } = await run('tesseract', ['--list-langs'], { timeout: 10_000 });
+    const have = new Set(`${stdout}\n${stderr}`.split(/\s+/));
+    langsCache = ['rus', 'kaz', 'eng'].filter((l) => have.has(l)).join('+');
+  } catch {
+    langsCache = '';
+  }
+  return langsCache || null;
+};
+
+const has = async (bin: string, args: string[] = ['-v']) => {
+  try { await run(bin, args, { timeout: 10_000 }); return true; } catch (e: any) { return e?.code !== 'ENOENT'; }
+};
+
+const clean = (t: string) =>
+  t.replace(/\r/g, '').replace(/\f/g, '\n').replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim().slice(0, MAX_TEXT);
+
+const ocrImage = async (file: string, langs: string): Promise<string> => {
+  const { stdout } = await run('tesseract', [file, 'stdout', '-l', langs, '--psm', '3'], {
+    timeout: OCR_TIMEOUT_MS, maxBuffer: 20 * 1024 * 1024,
+  });
+  return stdout;
+};
+
+const isPdf = (b: Buffer) => b.subarray(0, 5).toString('latin1') === '%PDF-';
+const isZip = (b: Buffer) => b[0] === 0x50 && b[1] === 0x4b;
+
+/** Извлечь текст из файла (буфер + MIME) */
+export const extractText = async (buffer: Buffer, mimeType: string): Promise<Extracted> => {
+  const mime = mimeType || '';
+
+  if (mime.includes('word')) {
+    try {
+      const text = isZip(buffer)
+        ? (await mammoth.extractRawText({ buffer })).value
+        : (await new WordExtractor().extract(buffer)).getBody();
+      return { text: clean(text), method: 'word' };
+    } catch {
+      return { text: '', method: 'none', error: 'Не удалось прочитать документ Word' };
+    }
+  }
+
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'umai-doc-'));
+  try {
+    if (mime === 'application/pdf' || isPdf(buffer)) {
+      const src = path.join(dir, 'in.pdf');
+      await fs.writeFile(src, buffer);
+      let pages = 0;
+      try {
+        const { stdout } = await run('pdfinfo', [src], { timeout: 20_000 });
+        pages = Number(/Pages:\s+(\d+)/.exec(stdout)?.[1] || 0);
+      } catch { /* битый или зашифрованный PDF */ }
+
+      // 1) Текстовый слой
+      let text = '';
+      try {
+        const { stdout } = await run('pdftotext', ['-layout', '-enc', 'UTF-8', src, '-'], {
+          timeout: 60_000, maxBuffer: 50 * 1024 * 1024,
+        });
+        text = clean(stdout);
+      } catch (e: any) {
+        if (e?.code === 'ENOENT') return { text: '', method: 'none', error: 'На сервере не установлен poppler-utils' };
+      }
+      // Достаточно текста (≈ 40+ букв на страницу) — это не скан
+      const letters = (text.match(/\p{L}/gu) || []).length;
+      if (letters >= Math.max(40, 40 * pages)) return { text, method: 'text', pages };
+
+      // 2) Скан — распознаём постранично
+      const langs = await ocrLangs();
+      if (!langs) return { text, method: text ? 'text' : 'none', pages, error: 'Распознавание сканов недоступно (нет tesseract)' };
+      const last = Math.min(pages || MAX_OCR_PAGES, MAX_OCR_PAGES);
+      await run('pdftoppm', ['-r', '250', '-gray', '-png', '-f', '1', '-l', String(last), src, path.join(dir, 'p')], {
+        timeout: 180_000,
+      });
+      const imgs = (await fs.readdir(dir)).filter((f) => /^p-\d+\.png$/.test(f)).sort();
+      const parts: string[] = [];
+      for (const [i, f] of imgs.entries()) {
+        const t = clean(await ocrImage(path.join(dir, f), langs));
+        parts.push(imgs.length > 1 ? `— Страница ${i + 1} —\n${t || '(текст не распознан)'}` : t);
+      }
+      const note = pages > last ? `\n\n(Распознаны первые ${last} из ${pages} страниц)` : '';
+      return { text: clean(parts.join('\n\n')) + note, method: 'ocr', pages };
+    }
+
+    if (mime.startsWith('image/')) {
+      const langs = await ocrLangs();
+      if (!langs) return { text: '', method: 'none', error: 'Распознавание изображений недоступно (нет tesseract)' };
+      let src = path.join(dir, mime === 'image/png' ? 'in.png' : mime === 'image/jpeg' ? 'in.jpg' : 'in.heic');
+      await fs.writeFile(src, buffer);
+      if (src.endsWith('.heic')) {
+        if (!(await has('heif-convert', ['--version']))) return { text: '', method: 'none', error: 'Формат HEIC не поддерживается сервером' };
+        const out = path.join(dir, 'in.jpg');
+        await run('heif-convert', [src, out], { timeout: 60_000 });
+        src = out;
+      }
+      return { text: clean(await ocrImage(src, langs)), method: 'ocr', pages: 1 };
+    }
+
+    return { text: '', method: 'none', error: 'Этот формат нельзя расшифровать' };
+  } catch (err) {
+    console.error('[doc-text] extract failed', err);
+    return { text: '', method: 'none', error: 'Не удалось расшифровать документ' };
+  } finally {
+    fs.rm(dir, { recursive: true, force: true }).catch(() => {});
+  }
+};
+
+/** HEIC → JPEG (для вставки фото в досье). null — если конвертер недоступен. */
+export const heicToJpeg = async (buffer: Buffer): Promise<Buffer | null> => {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'umai-heic-'));
+  try {
+    await fs.writeFile(path.join(dir, 'in.heic'), buffer);
+    await run('heif-convert', ['-q', '85', path.join(dir, 'in.heic'), path.join(dir, 'out.jpg')], { timeout: 60_000 });
+    return await fs.readFile(path.join(dir, 'out.jpg'));
+  } catch {
+    return null;
+  } finally {
+    fs.rm(dir, { recursive: true, force: true }).catch(() => {});
+  }
+};
+
+// ─── Кэш в документе и очередь ───────────────────────────────────────────────
+
+/** Расшифровка документа: из кэша или заново (результат сохраняется). */
+export const getDocumentText = async (doc: any, buffer?: Buffer, force = false): Promise<Extracted> => {
+  if (!force && doc.extractedAt && (doc.extractedText || doc.extractError)) {
+    return { text: doc.extractedText || '', method: doc.extractMethod || 'none', error: doc.extractError || undefined };
+  }
+  const provider = doc.storageProvider as StorageProvider | undefined;
+  if (!buffer) {
+    if (!provider || !doc.storageKey || !isProviderAvailable(provider)) {
+      return { text: '', method: 'none', error: 'Файл недоступен в хранилище' };
+    }
+    buffer = await downloadStored(provider, doc.storageKey);
+  }
+  const r = await extractText(buffer, doc.mimeType);
+  await DocumentModel.updateOne({ _id: doc._id }, {
+    $set: { extractedText: r.text, extractMethod: r.method, extractError: r.error ?? '', extractedAt: new Date() },
+  }).catch(() => {});
+  return r;
+};
+
+// Одна задача за раз: распознавание тяжёлое, а сервер небольшой
+let chain: Promise<unknown> = Promise.resolve();
+export const queueExtraction = (documentId: string): void => {
+  chain = chain.then(async () => {
+    try {
+      const doc = await DocumentModel.findById(documentId).lean();
+      if (doc) await getDocumentText(doc);
+    } catch (err) {
+      console.error('[doc-text] background extract failed', documentId, err);
+    }
+  });
+};
