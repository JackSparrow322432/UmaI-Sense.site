@@ -0,0 +1,328 @@
+import { useEffect, useMemo, useState, type ReactNode } from 'react';
+import { toast } from 'sonner';
+import { adminApi } from '../../../api';
+import type { AdminAuditEntry, DocumentItem } from '../../../types';
+
+/**
+ * Документы ребёнка и журнал доступа в админке:
+ *  • список документов: открыть, скачать, посмотреть расшифровку (текст документа);
+ *  • журнал доступа: понятные формулировки, группировка по дням, фильтры,
+ *    документ из любой записи журнала можно открыть одним нажатием.
+ */
+
+// ─── Общие помощники ─────────────────────────────────────────────────────────
+
+const ROLE: Record<string, { label: string; color: string; bg: string }> = {
+  admin:   { label: 'Администратор', color: '#7C3AED', bg: '#F5F3FF' },
+  parent:  { label: 'Родитель',      color: '#E07628', bg: '#FFF3EA' },
+  trainer: { label: 'Тренер',        color: '#0F766E', bg: '#ECFDF5' },
+};
+
+const sizeLabel = (b?: number) =>
+  !b ? '' : b > 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} МБ` : `${Math.ceil(b / 1024)} КБ`;
+
+const kindOf = (mime = '', name = '') => {
+  if (mime === 'application/pdf' || /\.pdf$/i.test(name)) return { label: 'PDF', color: '#DC2626', bg: '#FEF2F2' };
+  if (mime.includes('word') || /\.docx?$/i.test(name)) return { label: 'DOC', color: '#2563EB', bg: '#EFF6FF' };
+  if (mime.startsWith('image/') || /\.(jpe?g|png|heic)$/i.test(name)) return { label: 'ФОТО', color: '#059669', bg: '#ECFDF5' };
+  return { label: 'ФАЙЛ', color: '#6B7280', bg: '#F3F4F6' };
+};
+
+const METHOD: Record<string, string> = {
+  text: 'Текст из PDF',
+  ocr: 'Распознано со скана',
+  word: 'Текст документа Word',
+  none: '',
+};
+
+const fmtTime = (d: string) => new Date(d).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
+const fmtDay = (d: string) => {
+  const day = new Date(d); const today = new Date();
+  const y = new Date(); y.setDate(today.getDate() - 1);
+  const same = (a: Date, b: Date) => a.toDateString() === b.toDateString();
+  if (same(day, today)) return 'Сегодня';
+  if (same(day, y)) return 'Вчера';
+  return day.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
+};
+
+/** Открыть документ в новой вкладке (ссылка действует 5 минут) */
+const useOpenDocument = (childId: string) => async (documentId: string, inline = true) => {
+  // Окно открываем сразу, по клику — иначе браузер заблокирует всплывающее окно
+  const win = inline ? window.open('', '_blank') : null;
+  try {
+    const { data } = await adminApi.openChildDocument(childId, documentId, inline);
+    if (win) win.location.href = data.url;
+    else window.location.href = data.url;
+  } catch (err: any) {
+    win?.close();
+    toast.error(err?.response?.data?.message || 'Не удалось открыть документ');
+  }
+};
+
+const Icon = {
+  doc: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>,
+  eye: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>,
+  upload: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>,
+  download: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>,
+  trash: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>,
+  key: <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/></svg>,
+  text: <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/></svg>,
+  lock: <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>,
+};
+
+// ─── Окно расшифровки ────────────────────────────────────────────────────────
+
+export function TranscriptModal({ childId, doc, onClose }: {
+  childId: string; doc: { _id: string; fileName: string }; onClose: () => void;
+}) {
+  const [loading, setLoading] = useState(true);
+  const [data, setData] = useState<{ text: string; method: string; error?: string } | null>(null);
+  const open = useOpenDocument(childId);
+
+  const load = (refresh = false) => {
+    setLoading(true);
+    adminApi.getDocumentText(childId, doc._id, refresh)
+      .then(({ data }) => setData(data))
+      .catch((err) => setData({ text: '', method: 'none', error: err?.response?.data?.message || 'Не удалось расшифровать документ' }))
+      .finally(() => setLoading(false));
+  };
+  useEffect(() => { load(); }, [doc._id]);
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onClose();
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [onClose]);
+
+  const copy = async () => {
+    try { await navigator.clipboard.writeText(data?.text || ''); toast.success('Текст скопирован'); }
+    catch { toast.error('Не удалось скопировать'); }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4" onClick={onClose}>
+      <div className="bg-white rounded-2xl w-full max-w-3xl max-h-[88vh] flex flex-col shadow-xl" onClick={(e) => e.stopPropagation()}>
+        <div className="px-5 py-4 border-b border-gray-100 flex items-start gap-3">
+          <div className="flex-1 min-w-0">
+            <p className="text-[11px] font-semibold uppercase tracking-wide text-[#E07628]">Расшифровка документа</p>
+            <p className="text-base font-bold text-gray-900 truncate mt-0.5">{doc.fileName}</p>
+            {data?.method && METHOD[data.method] && (
+              <p className="text-xs text-gray-400 mt-0.5">{METHOD[data.method]} · обработано на сервере UmaiSense в РК</p>
+            )}
+          </div>
+          <button onClick={onClose} className="w-8 h-8 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 text-xl leading-none">×</button>
+        </div>
+
+        <div className="flex-1 overflow-auto px-5 py-4">
+          {loading ? (
+            <div className="py-14 flex flex-col items-center gap-3 text-sm text-gray-400">
+              <div className="w-7 h-7 border-2 border-[#E07628] border-t-transparent rounded-full animate-spin" />
+              Расшифровываем… Для сканов это может занять до минуты.
+            </div>
+          ) : data?.text ? (
+            <>
+              {data.method === 'ocr' && (
+                <p className="text-xs bg-amber-50 text-amber-700 rounded-lg px-3 py-2 mb-3">
+                  Текст распознан автоматически со скана и может содержать неточности — сверяйтесь с оригиналом.
+                </p>
+              )}
+              <pre className="whitespace-pre-wrap font-sans text-sm text-gray-800 leading-relaxed">{data.text}</pre>
+            </>
+          ) : (
+            <p className="py-10 text-center text-sm text-gray-400">{data?.error || 'Текст в документе не найден.'}</p>
+          )}
+        </div>
+
+        <div className="px-5 py-3 border-t border-gray-100 flex flex-wrap gap-2 justify-end">
+          <button onClick={() => load(true)} disabled={loading} className="px-3 py-2 rounded-xl text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50">Распознать заново</button>
+          <button onClick={copy} disabled={loading || !data?.text} className="px-3 py-2 rounded-xl text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50">Копировать текст</button>
+          <button onClick={() => open(doc._id)} className="px-4 py-2 rounded-xl text-sm font-semibold bg-[#E07628] hover:bg-[#C9661F] text-white">Открыть оригинал</button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+// ─── Документы ───────────────────────────────────────────────────────────────
+
+export function ChildDocumentsAdmin({ childId }: { childId: string }) {
+  const [docs, setDocs] = useState<DocumentItem[] | null>(null);
+  const [transcript, setTranscript] = useState<{ _id: string; fileName: string } | null>(null);
+  const open = useOpenDocument(childId);
+
+  useEffect(() => {
+    adminApi.getChildDocuments(childId).then(({ data }) => setDocs(data)).catch(() => setDocs([]));
+  }, [childId]);
+
+  return (
+    <div>
+      <p className="text-xs font-medium text-gray-500 mb-3">Документы{docs ? ` · ${docs.length}` : ''}</p>
+      <div className="bg-white rounded-xl border border-gray-200 divide-y divide-gray-50">
+        {docs === null ? (
+          <p className="px-5 py-6 text-sm text-gray-400">Загрузка…</p>
+        ) : docs.length === 0 ? (
+          <p className="px-5 py-6 text-sm text-gray-400">Документов пока нет</p>
+        ) : docs.map((d) => {
+          const k = kindOf(d.mimeType, d.fileName);
+          const by = typeof d.uploadedBy === 'object' ? d.uploadedBy : null;
+          const role = by ? ROLE[by.role as string] : null;
+          return (
+            <div key={d._id} className="px-4 py-3.5 flex items-center gap-3 flex-wrap sm:flex-nowrap">
+              <div className="w-10 h-10 rounded-xl flex items-center justify-center text-[10px] font-bold flex-shrink-0" style={{ backgroundColor: k.bg, color: k.color }}>
+                {k.label}
+              </div>
+              <div className="flex-1 min-w-0">
+                <button onClick={() => open(d._id)} className="text-sm font-semibold text-gray-900 hover:text-[#E07628] truncate block max-w-full text-left">
+                  {d.fileName}
+                </button>
+                <p className="text-xs text-gray-400 mt-0.5">
+                  {new Date(d.createdAt).toLocaleDateString('ru-RU')} · {by?.name || '—'}
+                  {role && <span className="ml-1" style={{ color: role.color }}>({role.label.toLowerCase()})</span>}
+                  {d.size ? ` · ${sizeLabel(d.size)}` : ''}
+                </p>
+              </div>
+              <div className="flex items-center gap-1.5 flex-shrink-0">
+                <button onClick={() => setTranscript({ _id: d._id, fileName: d.fileName })}
+                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-[#E07628] bg-[#FFF3EA] hover:bg-[#FFE6D2]">
+                  {Icon.text} Расшифровка
+                </button>
+                <button onClick={() => open(d._id)} title="Открыть" className="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100">{Icon.eye}</button>
+                <button onClick={() => open(d._id, false)} title="Скачать" className="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100">{Icon.download}</button>
+              </div>
+            </div>
+          );
+        })}
+      </div>
+      {transcript && <TranscriptModal childId={childId} doc={transcript} onClose={() => setTranscript(null)} />}
+    </div>
+  );
+}
+
+// ─── Журнал доступа ──────────────────────────────────────────────────────────
+
+const ACTION: Record<string, { verb: string; icon: ReactNode; color: string; bg: string; group: Filter }> = {
+  'child.view':           { verb: 'открыл(а) профиль ребёнка', icon: Icon.eye,      color: '#2563EB', bg: '#EFF6FF', group: 'profile' },
+  'child.export':         { verb: 'скачал(а) досье в PDF',      icon: Icon.download, color: '#E07628', bg: '#FFF3EA', group: 'export' },
+  'child.access_granted': { verb: 'получил(а) доступ по коду',   icon: Icon.key,      color: '#7C3AED', bg: '#F5F3FF', group: 'profile' },
+  'document.view':        { verb: 'открыл(а) документ',          icon: Icon.doc,      color: '#0F766E', bg: '#ECFDF5', group: 'docs' },
+  'document.upload':      { verb: 'загрузил(а) документ',        icon: Icon.upload,   color: '#059669', bg: '#ECFDF5', group: 'docs' },
+  'document.delete':      { verb: 'удалил(а) документ',          icon: Icon.trash,    color: '#DC2626', bg: '#FEF2F2', group: 'docs' },
+};
+
+type Filter = 'all' | 'docs' | 'profile' | 'export';
+const FILTERS: { key: Filter; label: string }[] = [
+  { key: 'all', label: 'Все' },
+  { key: 'docs', label: 'Документы' },
+  { key: 'profile', label: 'Просмотры профиля' },
+  { key: 'export', label: 'Скачивания досье' },
+];
+
+export function ChildAuditAdmin({ childId }: { childId: string }) {
+  const [entries, setEntries] = useState<AdminAuditEntry[] | null>(null);
+  const [filter, setFilter] = useState<Filter>('all');
+  const [limit, setLimit] = useState(30);
+  const [transcript, setTranscript] = useState<{ _id: string; fileName: string } | null>(null);
+  const open = useOpenDocument(childId);
+
+  const load = () => adminApi.getChildAudit(childId).then(({ data }) => setEntries(data)).catch(() => setEntries([]));
+  useEffect(() => { load(); }, [childId]);
+
+  const filtered = useMemo(
+    () => (entries || []).filter((e) => filter === 'all' || ACTION[e.action]?.group === filter),
+    [entries, filter]
+  );
+  const groups = useMemo(() => {
+    const out: { day: string; items: AdminAuditEntry[] }[] = [];
+    for (const e of filtered.slice(0, limit)) {
+      const day = fmtDay(e.createdAt);
+      if (out.at(-1)?.day !== day) out.push({ day, items: [] });
+      out.at(-1)!.items.push(e);
+    }
+    return out;
+  }, [filtered, limit]);
+
+  const count = (f: Filter) => (entries || []).filter((e) => f === 'all' || ACTION[e.action]?.group === f).length;
+
+  return (
+    <div className="bg-white rounded-xl border border-gray-200">
+      <div className="px-5 pt-5 pb-3 flex items-start gap-3">
+        <div className="w-9 h-9 rounded-xl bg-gray-100 text-gray-600 flex items-center justify-center flex-shrink-0">{Icon.lock}</div>
+        <div className="flex-1">
+          <p className="text-sm font-bold text-gray-900">Журнал доступа</p>
+          <p className="text-xs text-gray-400 mt-0.5">Кто и когда смотрел данные и документы ребёнка. Записи хранятся 3 года.</p>
+        </div>
+        <button onClick={load} className="text-xs text-gray-400 hover:text-gray-700 px-2 py-1 rounded-lg hover:bg-gray-50">Обновить</button>
+      </div>
+
+      <div className="px-5 pb-3 flex flex-wrap gap-2">
+        {FILTERS.map((f) => (
+          <button key={f.key} onClick={() => { setFilter(f.key); setLimit(30); }}
+            className={`px-3 py-1.5 rounded-full text-xs font-medium transition ${filter === f.key ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>
+            {f.label} <span className="opacity-60">{entries ? count(f.key) : ''}</span>
+          </button>
+        ))}
+      </div>
+
+      {entries === null ? (
+        <p className="px-5 pb-6 text-sm text-gray-400">Загрузка…</p>
+      ) : filtered.length === 0 ? (
+        <p className="px-5 pb-6 text-sm text-gray-400">Записей нет</p>
+      ) : (
+        <div className="pb-2">
+          {groups.map((g) => (
+            <div key={g.day}>
+              <p className="px-5 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-400 bg-gray-50/70 border-y border-gray-100">{g.day}</p>
+              <ul className="divide-y divide-gray-50">
+                {g.items.map((e) => {
+                  const a = ACTION[e.action] ?? { verb: e.action, icon: Icon.eye, color: '#6B7280', bg: '#F3F4F6', group: 'all' as Filter };
+                  const role = ROLE[(e.userId?.role || e.role) as string];
+                  const transcriptView = !!e.meta?.transcript;
+                  return (
+                    <li key={e._id} className="px-5 py-3 flex items-start gap-3">
+                      <div className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5" style={{ backgroundColor: a.bg, color: a.color }}>
+                        {a.icon}
+                      </div>
+                      <div className="flex-1 min-w-0">
+                        <p className="text-sm text-gray-800 leading-snug">
+                          <b className="font-semibold">{e.userId?.name || 'Удалённый пользователь'}</b>{' '}
+                          {role && (
+                            <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded-full align-middle mr-1" style={{ backgroundColor: role.bg, color: role.color }}>
+                              {role.label}
+                            </span>
+                          )}
+                          {transcriptView ? 'открыл(а) расшифровку документа' : a.verb}
+                          {e.document && <> «<span className="font-medium">{e.document.fileName}</span>»</>}
+                        </p>
+                        {e.document && (
+                          e.document.exists ? (
+                            <div className="flex gap-3 mt-1.5">
+                              <button onClick={() => open(e.document!._id)} className="text-xs font-semibold text-[#E07628] hover:underline">Открыть документ</button>
+                              <button onClick={() => setTranscript({ _id: e.document!._id, fileName: e.document!.fileName })} className="text-xs font-semibold text-gray-500 hover:text-gray-800 hover:underline">Расшифровка</button>
+                            </div>
+                          ) : (
+                            <p className="text-xs text-gray-400 mt-1">Документ удалён</p>
+                          )
+                        )}
+                      </div>
+                      <div className="text-right flex-shrink-0">
+                        <p className="text-sm text-gray-700 tabular-nums">{fmtTime(e.createdAt)}</p>
+                        {e.ip && <p className="text-[10px] text-gray-400 tabular-nums mt-0.5" title="IP-адрес">{e.ip}</p>}
+                      </div>
+                    </li>
+                  );
+                })}
+              </ul>
+            </div>
+          ))}
+          {filtered.length > limit && (
+            <div className="px-5 pt-2 pb-3">
+              <button onClick={() => setLimit((l) => l + 50)} className="w-full py-2 rounded-xl text-sm text-gray-600 bg-gray-50 hover:bg-gray-100">
+                Показать ещё ({filtered.length - limit})
+              </button>
+            </div>
+          )}
+        </div>
+      )}
+      {transcript && <TranscriptModal childId={childId} doc={transcript} onClose={() => setTranscript(null)} />}
+    </div>
+  );
+}
