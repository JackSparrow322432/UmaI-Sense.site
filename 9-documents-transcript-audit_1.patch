+// GET /api/admin/children/:childId/documents — все документы ребёнка
+export const listChildDocuments = async (req: AuthRequest, res: Response): Promise<void> => {
+  try {
+    const docs = await DocumentModel.find({ childId: req.params['childId'], status: { $ne: 'uploading' } })
+      .select('-storageKey -storageProvider -uploadExpiresAt')
+      .populate('uploadedBy', 'name email role')
+      .sort({ createdAt: -1 })
+      .lean();
+    res.json(docs);
+  } catch {
+    res.status(500).json({ message: 'Server error' });
+  }
+};
+
+const findChildDocument = (req: AuthRequest, withText = false) => {
+  const q = DocumentModel.findOne({
+    _id: req.params['documentId'], childId: req.params['childId'], status: { $ne: 'uploading' },
+  });
+  return withText ? q.select('+extractedText') : q;
+};
+
+// GET /api/admin/children/:childId/documents/:documentId/open?inline=1 — ссылка на 5 минут
+export const openChildDocument = async (req: AuthRequest, res: Response): Promise<void> => {
+  try {
+    const d = await findChildDocument(req);
+    if (!d) { res.status(404).json({ message: 'Документ не найден (возможно, удалён)' }); return; }
+    let url: string;
+    if (d.storageKey) {
+      const provider: StorageProvider = d.storageProvider === 'cloudinary' ? 'cloudinary' : 's3';
+      if (!isProviderAvailable(provider)) { res.status(503).json({ message: 'Хранилище недоступно' }); return; }
+      url = await storageDownloadUrl(provider, d.storageKey, d.fileName, req.query['inline'] === '1');
+    } else if (d.fileUrl) {
+      url = d.fileUrl;
+    } else {
+      res.status(404).json({ message: 'Файл документа не найден' }); return;
+    }
+    await logAccess(req, { action: 'document.view', childId: d.childId, documentId: d._id });
+    res.json({ url, expiresIn: 300 });
+  } catch {
+    res.status(500).json({ message: 'Server error' });
+  }
+};
+
+// GET /api/admin/children/:childId/documents/:documentId/text?refresh=1 — расшифровка
+export const getChildDocumentText = async (req: AuthRequest, res: Response): Promise<void> => {
+  try {
+    const d = await findChildDocument(req, true).lean();
+    if (!d) { res.status(404).json({ message: 'Документ не найден (возможно, удалён)' }); return; }
+    const r = await getDocumentText(d, undefined, req.query['refresh'] === '1');
+    await logAccess(req, { action: 'document.view', childId: d.childId, documentId: d._id, meta: { transcript: true } });
+    res.json({ fileName: d.fileName, ...r });
+  } catch (err) {
+    console.error('[admin] transcript failed', err);
+    res.status(500).json({ message: 'Не удалось расшифровать документ' });
+  }
+};
