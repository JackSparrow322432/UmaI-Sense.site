# ═════════════════════════════════════════════════════════════════════════════
# UmaiSense API — Yandex Cloud, регион Казахстан (kz1)
# Все данные (база, файлы, бэкапы, логи) — только в Казахстане. Сервер в production
# НЕ запустится, если какая-то настройка указывает за пределы РК (см. src/utils/env.ts).
# Файл с реальными значениями — только на сервере: /opt/umaisense/.env, права 600.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Сервер ──────────────────────────────────────────────────────────────────
# production — на сервере; development — локально (тогда коды входа видны в консоли)
NODE_ENV=production
PORT=5000
# Сколько прокси перед приложением (nginx = 1)
TRUST_PROXY=1
# Адрес сайта (сайт и API на одном домене, API — /api)
CLIENT_URL=https://app.umaisense.kz
# Для nginx и Let's Encrypt (scripts/deploy.sh): домен без https:// и почта для уведомлений о сертификате
DOMAIN=app.umaisense.kz
LETSENCRYPT_EMAIL=
# true — MongoDB в контейнере на этой ВМ (профиль compose «mongo»), тогда нужен и MONGO_PASSWORD
USE_LOCAL_MONGO=false
MONGO_PASSWORD=
# Дополнительные домены для CORS через запятую (обычно пусто)
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=600

# ─── Безопасность ────────────────────────────────────────────────────────────
# Не короче 32 символов: openssl rand -base64 48
JWT_SECRET=
# Редакция текстов /privacy и /agreement (при изменении текста — поднять)
CONSENT_VERSION=2026-10-13
AUDIT_RETENTION_DAYS=1095

# ─── MongoDB в Казахстане ────────────────────────────────────────────────────
# Вариант 1 — Managed Service for MongoDB (StoreDoc) в kz1, если доступен:
#   mongodb://umaisense:ПАРОЛЬ@<хост>.mdb.yandexcloud.kz:27018/umai_sense?tls=true&tlsCAFile=/certs/root.crt&authSource=umai_sense
# Вариант 2 — MongoDB в Docker на этой же VM (infra/yandex-kz/app/docker-compose.yml, профиль mongo):
#   mongodb://umaisense:ПАРОЛЬ@mongo:27017/umai_sense?authSource=admin
MONGO_URI=
MONGO_POOL_SIZE=20

# ─── Yandex Object Storage (регион Казахстан) ────────────────────────────────
S3_ENDPOINT=https://storage.yandexcloud.kz
# Регион подписи для Object Storage KZ — проверьте в документации региона (обычно kz1)
S3_REGION=kz1
S3_FORCE_PATH_STYLE=false
# Статический ключ сервисного аккаунта приложения (доступ только к своим бакетам)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Закрытый бакет — медицинские документы (доступ только по ссылке на 5 минут)
S3_PRIVATE_BUCKET=umaisense-documents
# Публичный бакет — фото профилей и обложки; раздаётся через nginx /media того же домена
S3_PUBLIC_BUCKET=umaisense-public
S3_PUBLIC_URL=https://app.umaisense.kz/media

# ─── Почта (коды входа) — только провайдер в РК ──────────────────────────────
# Почтовый хостинг в Казахстане (Postbox в регионе KZ пока нет).
# Gmail, SendGrid и другие зарубежные сервисы запрещены проверкой при старте.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Адрес почтового сервера в РК вне зоны yandexcloud.kz — добавить сюда (через запятую)
LOCALITY_ALLOWED_HOSTS=

# ─── ИИ ──────────────────────────────────────────────────────────────────────
# off    — выключен (данные никуда не уходят)
# yandex — YandexGPT; «в Казахстане» только если AI_YANDEX_BASE_URL в зоне yandexcloud.kz
# local  — своя модель на GPU-сервере в kz1 (AI_LOCAL_BASE_URL, AI_LOCAL_MODEL)
# openai — OpenAI (США): ЗАРУБЕЖНАЯ обработка, работает только при ALLOW_FOREIGN_AI=true
#          и только у родителей, давших согласие на трансграничную передачу
AI_SCREENING_PROVIDER=openai
ALLOW_FOREIGN_AI=true
OPENAI_API_KEY=
AI_SCREENING_MODEL=gpt-4o-mini
AI_VISION_MODEL=

AI_YANDEX_BASE_URL=
AI_YANDEX_API_KEY=
AI_YANDEX_FOLDER_ID=
AI_YANDEX_MODEL=yandexgpt/latest

AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=

AI_SCREENING_PERIOD_DAYS=30
AI_SCREENING_DAILY_LIMIT=5
# Учитывать содержание документов (PDF, Word и фото) в расшифровке, скрининге и советах ИИ.
# Во внешний ИИ уходит только ОБЕЗЛИЧЕННЫЙ текст (фото распознаются у нас, OCR) и только
# при согласиях родителя «анализ документов» и «трансграничная передача». false — не учитывать.
AI_SCREENING_DOCS_EXTERNAL=true
# Отправлять во внешний ИИ само ИЗОБРАЖЕНИЕ документа (ФИО и ИИН на фото не скрыть — только
# по решению юриста). Обычно не нужно: фото и так учитываются через распознанный текст.
AI_DOCS_IMAGES_EXTERNAL=false
AI_DOCS_DAILY_LIMIT=20

# ─── Администратор (создаётся при первом запуске, затем можно убрать) ────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
