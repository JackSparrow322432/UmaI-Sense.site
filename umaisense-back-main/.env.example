# ─── Сервер ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Сколько прокси перед приложением (nginx-балансировщик = 1)
TRUST_PROXY=1
# Домен фронтенда
CLIENT_URL=https://app.umaisense.kz
# Дополнительные разрешённые источники через запятую (необязательно)
CORS_ORIGINS=
# Разрешать превью-домены *.vercel.app (после переезда — false)
ALLOW_VERCEL_PREVIEWS=false
# Лимит запросов в минуту с одного IP (счётчик на каждом сервере приложения свой)
RATE_LIMIT_PER_MINUTE=600

# ─── Безопасность ────────────────────────────────────────────────────────────
# Не короче 32 символов, сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Версия текста согласия (меняется вместе с текстом на /privacy)
CONSENT_VERSION=2026-10-07
AUDIT_RETENTION_DAYS=1095

# ─── MongoDB: набор реплик из 3 узлов во внутренней сети ─────────────────────
MONGO_URI=mongodb://umaisense:ПАРОЛЬ@10.10.0.11:27017,10.10.0.12:27017,10.10.0.13:27017/umai_sense?replicaSet=rs0&authSource=admin
MONGO_POOL_SIZE=20

# ─── S3-хранилище в РК ───────────────────────────────────────────────────────
# Адрес S3 для сервера: внутренний адрес балансировщика (раздаёт запросы на 3 узла Garage)
S3_ENDPOINT=http://10.10.0.5:3900
# Адрес S3 для браузера (через nginx). Одноразовые ссылки подписываются на него
S3_PUBLIC_ENDPOINT=https://s3.umaisense.kz
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Закрытый бакет для медицинских документов
S3_PRIVATE_BUCKET=umaisense-documents
# Публичный бакет для картинок интерфейса и его внешний адрес
S3_PUBLIC_BUCKET=umaisense-public
S3_PUBLIC_URL=https://app.umaisense.kz/media

# ─── Администратор (создаётся при первом запуске) ────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Почта (коды входа) ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── ИИ-рекомендации (получают только обезличенные данные) ───────────────────
OPENAI_API_KEY=

# ─── Cloudinary — пока проект на Vercel (без S3) ─────────────────────────────
# Документы детей хранятся как ЗАКРЫТЫЕ файлы и открываются по ссылке на 5 минут.
# Как только заданы S3_*, новые документы идут в S3, а migrate:files переносит старые.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Максимальный размер документа в МБ (бесплатный тариф Cloudinary — 10 МБ для файлов)
CLOUDINARY_MAX_DOC_MB=10
