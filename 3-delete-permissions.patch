diff --git a/umaisense-back-main/src/middleware/auth.middleware.ts b/umaisense-back-main/src/middleware/auth.middleware.ts
index 3735939..548d379 100644
--- a/umaisense-back-main/src/middleware/auth.middleware.ts
+++ b/umaisense-back-main/src/middleware/auth.middleware.ts
@@ -68,3 +68,15 @@ export const trainerOnly = (req: AuthRequest, res: Response, next: NextFunction)
   }
   next();
 };
+
+/**
+ * Тренер видит данные ребёнка и добавляет наблюдения, но ничего не удаляет:
+ * удалять записи, документы и оценки может только родитель (владелец данных).
+ */
+export const noTrainerDelete = (req: AuthRequest, res: Response, next: NextFunction): void => {
+  if (req.user?.role === 'trainer') {
+    res.status(403).json({ message: 'Тренер не может удалять данные. Обратитесь к родителю или администратору.' });
+    return;
+  }
+  next();
+};
