diff --git a/infra/yandex-kz/cloud-init.yaml b/infra/yandex-kz/cloud-init.yaml
new file mode 100644
index 0000000..dac4fd9
--- /dev/null
+++ b/infra/yandex-kz/cloud-init.yaml
@@ -0,0 +1,80 @@
+#cloud-config
+# Первичная настройка ВМ umaisense-web (Ubuntu 24.04, Yandex Cloud kz1).
+# Выполняется один раз при создании ВМ; дальше сервер обновляется через scripts/deploy.sh.
+
+users:
+  - name: umaisense
+    groups: [sudo, docker]
+    shell: /bin/bash
+    sudo: "ALL=(ALL) NOPASSWD:ALL"
+    lock_passwd: true
+    ssh_authorized_keys:
+      - ${ssh_public_key}
+
+ssh_pwauth: false
+disable_root: true
+package_update: true
+package_upgrade: true
+timezone: Asia/Almaty
+
+packages:
+  - ca-certificates
+  - curl
+  - gnupg
+  - unattended-upgrades
+  - fail2ban
+  - ufw
+  - jq
+  - age
+  - conntrack
+
+write_files:
+  - path: /etc/ssh/sshd_config.d/90-umaisense.conf
+    content: |
+      PasswordAuthentication no
+      KbdInteractiveAuthentication no
+      PermitRootLogin no
+      MaxAuthTries 3
+  - path: /etc/apt/apt.conf.d/20auto-upgrades
+    content: |
+      APT::Periodic::Update-Package-Lists "1";
+      APT::Periodic::Unattended-Upgrade "1";
+  - path: /etc/fail2ban/jail.d/sshd.local
+    content: |
+      [sshd]
+      enabled = true
+      maxretry = 5
+      bantime = 1h
+  - path: /etc/docker/daemon.json
+    content: |
+      {
+        "log-driver": "json-file",
+        "log-opts": { "max-size": "10m", "max-file": "5" },
+        "live-restore": true
+      }
+
+runcmd:
+  # Docker из официального репозитория (download.docker.com — только установка пакетов, данные туда не уходят)
+  - install -m 0755 -d /etc/apt/keyrings
+  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
+  - chmod a+r /etc/apt/keyrings/docker.asc
+  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
+  - apt-get update
+  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
+  - usermod -aG docker umaisense
+  - systemctl enable --now docker
+  # Межсетевой экран на самой ВМ (дополнительно к группе безопасности)
+  - ufw default deny incoming
+  - ufw default allow outgoing
+  - ufw allow 22/tcp
+  - ufw allow 80/tcp
+  - ufw allow 443/tcp
+  - ufw --force enable
+  - systemctl restart ssh
+  - systemctl enable --now fail2ban
+  # Каталог приложения и сертификат Yandex Cloud для TLS-подключения к Managed MongoDB
+  - mkdir -p /opt/umaisense/certs /opt/umaisense/certbot/www /opt/umaisense/certbot/conf /opt/umaisense/frontend
+  # Публичный корневой сертификат Yandex Cloud (скачивается только файл сертификата, данные не передаются)
+  - curl -fsSL https://storage.yandexcloud.kz/cloud-certs/CA.pem -o /opt/umaisense/certs/root.crt || curl -fsSL https://storage.yandexcloud.net/cloud-certs/CA.pem -o /opt/umaisense/certs/root.crt
+  - chown -R umaisense:umaisense /opt/umaisense
+  - chmod 700 /opt/umaisense
diff --git a/infra/yandex-kz/compute.tf b/infra/yandex-kz/compute.tf
new file mode 100644
index 0000000..30c96ed
--- /dev/null
+++ b/infra/yandex-kz/compute.tf
@@ -0,0 +1,47 @@
+data "yandex_compute_image" "ubuntu" {
+  family = var.image_family
+}
+
+# Сервер приложения: nginx (HTTPS, сайт, /api, /media) + API в Docker (+ MongoDB, если не managed)
+resource "yandex_compute_instance" "web" {
+  name                      = "umaisense-web"
+  hostname                  = "umaisense-web"
+  platform_id               = var.vm_platform_id
+  zone                      = var.zone
+  allow_stopping_for_update = true
+
+  resources {
+    cores         = var.vm_cores
+    memory        = var.vm_memory_gb
+    core_fraction = var.vm_core_fraction
+  }
+
+  boot_disk {
+    initialize_params {
+      image_id   = data.yandex_compute_image.ubuntu.id
+      size       = var.vm_disk_gb
+      type       = "network-ssd"
+      kms_key_id = yandex_kms_symmetric_key.data.id # диск зашифрован ключом KMS
+    }
+  }
+
+  network_interface {
+    subnet_id          = yandex_vpc_subnet.main.id
+    nat                = true
+    nat_ip_address     = yandex_vpc_address.web.external_ipv4_address[0].address
+    security_group_ids = [yandex_vpc_security_group.web.id]
+  }
+
+  metadata = {
+    user-data          = templatefile("${path.module}/cloud-init.yaml", { ssh_public_key = var.ssh_public_key })
+    serial-port-enable = "0"
+  }
+
+  scheduling_policy {
+    preemptible = false
+  }
+
+  lifecycle {
+    ignore_changes = [boot_disk[0].initialize_params[0].image_id, metadata["user-data"]]
+  }
+}
diff --git a/infra/yandex-kz/dns.tf b/infra/yandex-kz/dns.tf
new file mode 100644
index 0000000..90c1688
--- /dev/null
+++ b/infra/yandex-kz/dns.tf
@@ -0,0 +1,16 @@
+# DNS в Cloud DNS KZ (необязательно). Иначе создайте у регистратора .kz A-запись: домен → output web_ip
+resource "yandex_dns_zone" "main" {
+  count  = var.manage_dns ? 1 : 0
+  name   = "umaisense"
+  zone   = var.dns_zone
+  public = true
+}
+
+resource "yandex_dns_recordset" "app" {
+  count   = var.manage_dns ? 1 : 0
+  zone_id = yandex_dns_zone.main[0].id
+  name    = "${var.domain}."
+  type    = "A"
+  ttl     = 300
+  data    = [yandex_vpc_address.web.external_ipv4_address[0].address]
+}
diff --git a/infra/yandex-kz/iam.tf b/infra/yandex-kz/iam.tf
new file mode 100644
index 0000000..872e3d3
--- /dev/null
+++ b/infra/yandex-kz/iam.tf
@@ -0,0 +1,48 @@
+# Сервисный аккаунт приложения: только работа с объектами в бакетах этого каталога.
+# Каталог должен быть отдельным под UmaiSense — тогда роль на каталог = доступ только к своим бакетам.
+resource "yandex_iam_service_account" "app" {
+  name        = "umaisense-app"
+  description = "API UmaiSense: доступ к бакетам документов и картинок"
+}
+
+resource "yandex_resourcemanager_folder_iam_member" "app_storage" {
+  folder_id = var.folder_id
+  role      = "storage.editor"
+  member    = "serviceAccount:${yandex_iam_service_account.app.id}"
+}
+
+# Шифрование бакетов ключом KMS: приложению нужно право шифровать/расшифровывать
+resource "yandex_resourcemanager_folder_iam_member" "app_kms" {
+  folder_id = var.folder_id
+  role      = "kms.keys.encrypterDecrypter"
+  member    = "serviceAccount:${yandex_iam_service_account.app.id}"
+}
+
+# Статический ключ для S3 API — кладётся в /opt/umaisense/.env (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY)
+resource "yandex_iam_service_account_static_access_key" "app" {
+  service_account_id = yandex_iam_service_account.app.id
+  description        = "S3-ключ API UmaiSense"
+}
+
+# Отдельный аккаунт для бэкапов: пишет только в бакет бэкапов (роль uploader — без удаления)
+resource "yandex_iam_service_account" "backup" {
+  name        = "umaisense-backup"
+  description = "Ежедневные бэкапы базы в бакет бэкапов"
+}
+
+resource "yandex_resourcemanager_folder_iam_member" "backup_storage" {
+  folder_id = var.folder_id
+  role      = "storage.uploader"
+  member    = "serviceAccount:${yandex_iam_service_account.backup.id}"
+}
+
+resource "yandex_resourcemanager_folder_iam_member" "backup_kms" {
+  folder_id = var.folder_id
+  role      = "kms.keys.encrypterDecrypter"
+  member    = "serviceAccount:${yandex_iam_service_account.backup.id}"
+}
+
+resource "yandex_iam_service_account_static_access_key" "backup" {
+  service_account_id = yandex_iam_service_account.backup.id
+  description        = "S3-ключ для бэкапов"
+}
diff --git a/infra/yandex-kz/kms.tf b/infra/yandex-kz/kms.tf
new file mode 100644
index 0000000..6d0bf9b
--- /dev/null
+++ b/infra/yandex-kz/kms.tf
@@ -0,0 +1,12 @@
+# Ключ шифрования для бакетов и диска сервера (KMS доступен в регионе KZ: cpl.kms.api.yandexcloud.kz)
+resource "yandex_kms_symmetric_key" "data" {
+  name                = "umaisense-data"
+  description         = "Шифрование документов, бэкапов и диска сервера"
+  default_algorithm   = "AES_256"
+  rotation_period     = "8760h" # ротация раз в год
+  deletion_protection = true
+
+  lifecycle {
+    prevent_destroy = true
+  }
+}
diff --git a/infra/yandex-kz/mongodb.tf b/infra/yandex-kz/mongodb.tf
new file mode 100644
index 0000000..81ea914
--- /dev/null
+++ b/infra/yandex-kz/mongodb.tf
@@ -0,0 +1,51 @@
+# Managed Service for MongoDB в регионе Казахстан (API: mdb.api.yandexcloud.kz).
+# Если сервис недоступен в вашем аккаунте — use_managed_mongodb = false, и база поднимается
+# в Docker на сервере приложения (app/docker-compose.yml, профиль mongo).
+resource "yandex_mdb_mongodb_cluster" "main" {
+  count               = var.use_managed_mongodb ? 1 : 0
+  name                = "umaisense"
+  environment         = "PRODUCTION"
+  network_id          = yandex_vpc_network.main.id
+  security_group_ids  = [yandex_vpc_security_group.mongo[0].id]
+  deletion_protection = true
+
+  cluster_config {
+    version = var.mongo_version
+
+    backup_window_start {
+      hours   = 21 # 03:00 по Алматы
+      minutes = 0
+    }
+  }
+
+  database {
+    name = "umai_sense"
+  }
+
+  user {
+    name     = "umaisense"
+    password = var.mongo_password
+    permission {
+      database_name = "umai_sense"
+      roles         = ["readWrite"]
+    }
+  }
+
+  resources_mongod {
+    resource_preset_id = var.mongo_resource_preset
+    disk_size          = var.mongo_disk_gb
+    disk_type_id       = "network-ssd"
+  }
+
+  # Одна зона в регионе KZ: для отказоустойчивости хостов можно добавить ещё host-блоки в kz1-a
+  host {
+    zone_id   = var.zone
+    subnet_id = yandex_vpc_subnet.main.id
+  }
+
+  maintenance_window {
+    type = "WEEKLY"
+    day  = "SUN"
+    hour = 22 # 04:00 по Алматы (UTC+6)
+  }
+}
diff --git a/infra/yandex-kz/network.tf b/infra/yandex-kz/network.tf
new file mode 100644
index 0000000..b393af1
--- /dev/null
+++ b/infra/yandex-kz/network.tf
@@ -0,0 +1,20 @@
+resource "yandex_vpc_network" "main" {
