diff --git a/infra/yandex-kz/app/docker-compose.yml b/infra/yandex-kz/app/docker-compose.yml
new file mode 100644
index 0000000..8831463
--- /dev/null
+++ b/infra/yandex-kz/app/docker-compose.yml
@@ -0,0 +1,83 @@
+# UmaiSense на ВМ в Yandex Cloud (kz1). Каталог на сервере: /opt/umaisense
+#   docker compose up -d                    — Managed MongoDB (вариант А)
+#   docker compose --profile mongo up -d    — MongoDB в контейнере на этой же ВМ (вариант Б)
+# Секреты — только в /opt/umaisense/.env на сервере (chmod 600), не в git и не в GitHub.
+
+name: umaisense
+
+x-logging: &logging
+  driver: json-file
+  options: { max-size: "10m", max-file: "5" }
+
+services:
+  api:
+    image: umaisense-api:${APP_VERSION:-latest}
+    build:
+      context: ./src/umaisense-back-main
+    env_file: .env
+    environment:
+      NODE_ENV: production
+      PORT: "5000"
+      TRUST_PROXY: "1"
+    volumes:
+      - ./certs/root.crt:/certs/root.crt:ro
+    expose: ["5000"]
+    restart: unless-stopped
+    read_only: true
+    tmpfs: [/tmp]
+    security_opt: ["no-new-privileges:true"]
+    healthcheck:
+      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:5000/api/health/ready"]
+      interval: 15s
+      timeout: 5s
+      retries: 5
+      start_period: 30s
+    logging: *logging
+
+  nginx:
+    image: nginx:1.27-alpine
+    depends_on:
+      api: { condition: service_healthy }
+    ports: ["80:80", "443:443"]
+    environment:
+      DOMAIN: ${DOMAIN:?укажите DOMAIN в .env}
+      PUBLIC_BUCKET: ${S3_PUBLIC_BUCKET:?укажите S3_PUBLIC_BUCKET в .env}
+    volumes:
+      - ./nginx/templates:/etc/nginx/templates:ro
+      - ./frontend:/usr/share/nginx/html:ro
+      - ./certbot/www:/var/www/certbot:ro
+      - ./certbot/conf:/etc/letsencrypt:ro
+    restart: unless-stopped
+    logging: *logging
+
+  certbot:
+    image: certbot/certbot:v2.11.0
+    volumes:
+      - ./certbot/www:/var/www/certbot
+      - ./certbot/conf:/etc/letsencrypt
+    # Продление раз в 12 часов; nginx перечитывает сертификат по cron (см. scripts/deploy.sh)
+    entrypoint: /bin/sh -c 'trap exit TERM; while :; do certbot renew --webroot -w /var/www/certbot --quiet; sleep 12h & wait $${!}; done'
+    restart: unless-stopped
+    logging: *logging
+
+  mongo:
+    profiles: ["mongo"]
+    image: mongo:7.0
+    command: ["--auth", "--bind_ip_all"]
+    environment:
+      MONGO_INITDB_ROOT_USERNAME: umaisense
+      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD:?укажите MONGO_PASSWORD в .env}
+      MONGO_INITDB_DATABASE: umai_sense
+    volumes:
+      - mongo-data:/data/db
+    expose: ["27017"]
+    restart: unless-stopped
+    healthcheck:
+      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
+      interval: 20s
+      timeout: 5s
+      retries: 5
+    logging: *logging
+
+volumes:
+  mongo-data:
diff --git a/infra/yandex-kz/app/env.quickstart.example b/infra/yandex-kz/app/env.quickstart.example
new file mode 100644
index 0000000..f07176f
--- /dev/null
+++ b/infra/yandex-kz/app/env.quickstart.example
@@ -0,0 +1,48 @@
+# /opt/umaisense/.env — быстрый старт без домена (сервер и ресурсы созданы в консоли Yandex Cloud KZ).
+# Скопируйте на сервер:  cp /opt/umaisense/src/infra/yandex-kz/app/env.quickstart.example /opt/umaisense/.env
+# и заполните значения в <...> (без кавычек и пробелов; не используйте символ $ в паролях).
+# Файл не коммитить и никому не пересылать.
+
+NODE_ENV=production
+DEPLOY_REF=feature/ai-screening-privacy
+
+# Публичный IP сервера (Compute Cloud → ВМ → «Публичный IPv4»). Когда появится домен —
+# DOMAIN=app.umaisense.kz, CLIENT_URL/S3_PUBLIC_URL на https://домен, плюс LETSENCRYPT_EMAIL.
+DOMAIN=<IP>
+CLIENT_URL=http://<IP>
+LETSENCRYPT_EMAIL=
+
+# openssl rand -base64 48   (если переносите пользователей с Vercel — возьмите JWT_SECRET оттуда)
+JWT_SECRET=<секрет>
+
+# Managed MongoDB: «Подключиться» в консоли кластера → хосты *.mdb.yandexcloud.kz, порт 27018
+MONGO_URI=mongodb://umaisense:<пароль>@<хост>:27018/umai_sense?tls=true&tlsCAFile=/certs/root.crt&authSource=umai_sense
+USE_LOCAL_MONGO=false
+
+# Object Storage KZ: статический ключ сервисного аккаунта umaisense-app
+S3_ENDPOINT=https://storage.yandexcloud.kz
+S3_REGION=kz1
+S3_ACCESS_KEY_ID=<идентификатор ключа>
+S3_SECRET_ACCESS_KEY=<секретный ключ>
+S3_PRIVATE_BUCKET=<бакет документов>
+S3_PUBLIC_BUCKET=<публичный бакет>
+S3_PUBLIC_URL=http://<IP>/media
+
+# Почта в РК (можно позже: без неё работает вход по паролю, но не регистрация и сброс пароля)
+SMTP_HOST=
+SMTP_PORT=465
+SMTP_USER=
+SMTP_PASS=
+LOCALITY_ALLOWED_HOSTS=
+
+# ИИ: off — выключен; openai — только обезличенно и с согласием родителей
+AI_SCREENING_PROVIDER=openai
+ALLOW_FOREIGN_AI=true
+OPENAI_API_KEY=<ключ>
+
+# Администратор (создаётся при первом запуске, если его ещё нет в базе)
+ADMIN_EMAIL=<почта администратора>
+ADMIN_PASSWORD=<пароль администратора>
+
+CONSENT_VERSION=2026-10-09
+APP_TZ=Asia/Almaty
diff --git a/infra/yandex-kz/app/nginx/bootstrap-http.conf b/infra/yandex-kz/app/nginx/bootstrap-http.conf
new file mode 100644
index 0000000..18bb625
--- /dev/null
+++ b/infra/yandex-kz/app/nginx/bootstrap-http.conf
@@ -0,0 +1,7 @@
+# Временный конфиг до первого выпуска сертификата Let's Encrypt: только HTTP и ACME-проверка.
+server {
+    listen 80;
+    server_name _;
+    location /.well-known/acme-challenge/ { root /var/www/certbot; }
+    location / { return 200 "UmaiSense: certificate setup in progress\n"; add_header Content-Type text/plain; }
+}
diff --git a/infra/yandex-kz/app/nginx/http.conf.template b/infra/yandex-kz/app/nginx/http.conf.template
new file mode 100644
index 0000000..0a5908d
--- /dev/null
+++ b/infra/yandex-kz/app/nginx/http.conf.template
@@ -0,0 +1,69 @@
+# Шаблон nginx (envsubst подставляет ${DOMAIN} и ${PUBLIC_BUCKET} при старте контейнера).
+# РЕЖИМ БЕЗ HTTPS: запуск по IP-адресу до подключения домена (HTTPS=false или DOMAIN = IP).
+# Данные идут по сети без шифрования — только для проверки, не для реальных пользователей.
+
+server_tokens off;
+client_max_body_size 25m;
+
+gzip on;
+gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
+gzip_min_length 1024;
+
+map $http_upgrade $connection_upgrade { default upgrade; '' close; }
+
+server {
+    listen 80;
+    server_name ${DOMAIN};
+
+    location /.well-known/acme-challenge/ { root /var/www/certbot; }
+
+
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+    add_header X-Frame-Options "DENY" always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+    # Браузер обращается только к нашему домену и к хранилищу Yandex Cloud KZ (прямая загрузка документов)
+    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://storage.yandexcloud.kz https://*.storage.yandexcloud.kz; connect-src 'self' https://storage.yandexcloud.kz https://*.storage.yandexcloud.kz; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
+
+    # Внимание: add_header внутри location отменяет заголовки выше — кеш задаётся только через expires
+    root /usr/share/nginx/html;
+
+    # API
+    location /api/ {
+        proxy_pass http://api:5000;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header Upgrade $http_upgrade;
+        proxy_set_header Connection $connection_upgrade;
+        proxy_read_timeout 120s;
+        proxy_send_timeout 120s;
+    }
+
+    # Публичные файлы (аватары и т.п.) из бакета ${PUBLIC_BUCKET} — через наш домен
+    location /media/ {
+        resolver 77.88.8.8 77.88.8.1 valid=300s ipv6=off;
+        set $s3 storage.yandexcloud.kz;
+        rewrite ^/media/(.*)$ /${PUBLIC_BUCKET}/$1 break;
+        proxy_pass https://$s3;
+        proxy_set_header Host $s3;
+        proxy_ssl_server_name on;
+        proxy_hide_header Set-Cookie;
+        proxy_intercept_errors on;
+        expires 7d;
+    }
+
+    # Сборка Vite: хэшированные файлы кешируются надолго
+    location /assets/ {
+        expires 1y;
+        try_files $uri =404;
+    }
+
+    # SPA
+    location / {
+        expires -1;
+        try_files $uri $uri/ /index.html;
+    }
+}
diff --git a/infra/yandex-kz/app/nginx/templates/default.conf.template b/infra/yandex-kz/app/nginx/templates/default.conf.template
new file mode 100644
index 0000000..6a557b9
--- /dev/null
+++ b/infra/yandex-kz/app/nginx/templates/default.conf.template
@@ -0,0 +1,82 @@
+# Шаблон nginx (envsubst подставляет ${DOMAIN} и ${PUBLIC_BUCKET} при старте контейнера).
+# Пока нет сертификата, используйте nginx/bootstrap-http.conf (scripts/deploy.sh делает это сам).
+
+server_tokens off;
+client_max_body_size 25m;
+
+gzip on;
+gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
+gzip_min_length 1024;
+
+map $http_upgrade $connection_upgrade { default upgrade; '' close; }
+
+server {
+    listen 80;
+    server_name ${DOMAIN};
+
+    location /.well-known/acme-challenge/ { root /var/www/certbot; }
+    location / { return 301 https://$host$request_uri; }
+}
+
+server {
+    listen 443 ssl;
+    http2 on;
+    server_name ${DOMAIN};
+
+    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
+    ssl_protocols TLSv1.2 TLSv1.3;
+    ssl_prefer_server_ciphers off;
+    ssl_session_cache shared:SSL:10m;
+    ssl_session_timeout 1d;
+
+    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+    add_header X-Frame-Options "DENY" always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+    # Браузер обращается только к нашему домену и к хранилищу Yandex Cloud KZ (прямая загрузка документов)
+    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://storage.yandexcloud.kz https://*.storage.yandexcloud.kz; connect-src 'self' https://storage.yandexcloud.kz https://*.storage.yandexcloud.kz; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
+
+    # Внимание: add_header внутри location отменяет заголовки выше — кеш задаётся только через expires
+    root /usr/share/nginx/html;
+
+    # API
+    location /api/ {
+        proxy_pass http://api:5000;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto https;
+        proxy_set_header Upgrade $http_upgrade;
+        proxy_set_header Connection $connection_upgrade;
+        proxy_read_timeout 120s;
+        proxy_send_timeout 120s;
+    }
+
+    # Публичные файлы (аватары и т.п.) из бакета ${PUBLIC_BUCKET} — через наш домен
+    location /media/ {
+        resolver 77.88.8.8 77.88.8.1 valid=300s ipv6=off;
+        set $s3 storage.yandexcloud.kz;
+        rewrite ^/media/(.*)$ /${PUBLIC_BUCKET}/$1 break;
+        proxy_pass https://$s3;
+        proxy_set_header Host $s3;
+        proxy_ssl_server_name on;
+        proxy_hide_header Set-Cookie;
+        proxy_intercept_errors on;
+        expires 7d;
+    }
+
+    # Сборка Vite: хэшированные файлы кешируются надолго
+    location /assets/ {
+        expires 1y;
+        try_files $uri =404;
+    }
+
+    # SPA
+    location / {
+        expires -1;
+        try_files $uri $uri/ /index.html;
+    }
+}
