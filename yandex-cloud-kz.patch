+# ═════════════════════════════════════════════════════════════════════════════
+# UmaiSense API — Yandex Cloud, регион Казахстан (kz1)
+# Все данные (база, файлы, бэкапы, логи) — только в Казахстане. Сервер в production
+# НЕ запустится, если какая-то настройка указывает за пределы РК (см. src/utils/env.ts).
+# Файл с реальными значениями — только на сервере: /opt/umaisense/.env, права 600.
+# ═════════════════════════════════════════════════════════════════════════════
+
 # ─── Сервер ──────────────────────────────────────────────────────────────────
-# production — на сервере. Для локальной разработки: development (только тогда коды входа
-# показываются в консоли и в ответе API — раньше это происходило при любом значении, кроме production)
+# production — на сервере; development — локально (тогда коды входа видны в консоли)
 NODE_ENV=production
 PORT=5000
-# Сколько прокси перед приложением (nginx-балансировщик = 1)
+# Сколько прокси перед приложением (nginx = 1)
 TRUST_PROXY=1
-# Домен фронтенда
+# Адрес сайта (сайт и API на одном домене, API — /api)
 CLIENT_URL=https://app.umaisense.kz
-# Дополнительные разрешённые источники через запятую (необязательно)
+# Для nginx и Let's Encrypt (scripts/deploy.sh): домен без https:// и почта для уведомлений о сертификате
+DOMAIN=app.umaisense.kz
+LETSENCRYPT_EMAIL=
+# true — MongoDB в контейнере на этой ВМ (профиль compose «mongo»), тогда нужен и MONGO_PASSWORD
+USE_LOCAL_MONGO=false
+MONGO_PASSWORD=
+# Дополнительные домены для CORS через запятую (обычно пусто)
 CORS_ORIGINS=
-# Разрешать превью-домены *.vercel.app (после переезда — false)
-ALLOW_VERCEL_PREVIEWS=false
-# Лимит запросов в минуту с одного IP (счётчик на каждом сервере приложения свой)
 RATE_LIMIT_PER_MINUTE=600
 
 # ─── Безопасность ────────────────────────────────────────────────────────────
-# Не короче 32 символов, сгенерировать: openssl rand -base64 48
+# Не короче 32 символов: openssl rand -base64 48
 JWT_SECRET=
-# Версия текста согласия (меняется вместе с текстом на /privacy и /agreement).
-# Пользователи без согласия текущей версии увидят окно с обновлённой политикой.
-CONSENT_VERSION=2026-10-08
+# Редакция текстов /privacy и /agreement (при изменении текста — поднять)
