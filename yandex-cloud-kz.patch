index 0000000..fde5186
--- /dev/null
+++ b/infra/yandex-kz/scripts/bootstrap-state.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Однократная подготовка: профиль yc для региона Казахстан, сервисный аккаунт для Terraform
+# и бакет для состояния Terraform (state хранится в KZ, не локально и не в Terraform Cloud).
+#
+# Запуск (на своём компьютере/в WSL, где установлен yc CLI):
+#   CLOUD_ID=... FOLDER_ID=... ./bootstrap-state.sh
+# Ничего платного, кроме крошечного бакета для state, не создаётся.
+set -euo pipefail
+
+: "${CLOUD_ID:?укажите CLOUD_ID}"
+: "${FOLDER_ID:?укажите FOLDER_ID}"
+PROFILE="${PROFILE:-umaisense-kz}"
+SA_NAME="${SA_NAME:-umaisense-terraform}"
+STATE_BUCKET="${STATE_BUCKET:-umaisense-tfstate-$(echo "$FOLDER_ID" | tr 'A-Z' 'a-z' | tail -c 9)}"
+OUT_DIR="${OUT_DIR:-$HOME/.umaisense-kz}"
+
+mkdir -p "$OUT_DIR" && chmod 700 "$OUT_DIR"
+
+if ! yc config profile get "$PROFILE" >/dev/null 2>&1; then
+  yc config profile create "$PROFILE"
+fi
+yc config profile activate "$PROFILE"
+yc config set endpoint api.yandexcloud.kz:443
+yc config set cloud-id "$CLOUD_ID"
+yc config set folder-id "$FOLDER_ID"
+echo "Если ещё не вошли: yc init --endpoint api.yandexcloud.kz:443 (или yc config set token ...)"
+
+if ! yc iam service-account get "$SA_NAME" >/dev/null 2>&1; then
+  yc iam service-account create --name "$SA_NAME" --description "Terraform для UmaiSense (kz1)"
+fi
+SA_ID=$(yc iam service-account get "$SA_NAME" --format json | jq -r .id)
+
+# Права только на каталог проекта
+for role in admin; do
+  yc resource-manager folder add-access-binding "$FOLDER_ID" --role "$role" --subject "serviceAccount:$SA_ID" >/dev/null || true
+done
+
+if [ ! -f "$OUT_DIR/sa-key.json" ]; then
+  yc iam key create --service-account-id "$SA_ID" --output "$OUT_DIR/sa-key.json"
+  chmod 600 "$OUT_DIR/sa-key.json"
+fi
+
+if [ ! -f "$OUT_DIR/storage-keys.json" ]; then
+  yc iam access-key create --service-account-id "$SA_ID" --format json > "$OUT_DIR/storage-keys.json"
+  chmod 600 "$OUT_DIR/storage-keys.json"
+fi
+ACCESS_KEY=$(jq -r .access_key.key_id "$OUT_DIR/storage-keys.json")
+SECRET_KEY=$(jq -r .secret "$OUT_DIR/storage-keys.json")
+
+if ! yc storage bucket get "$STATE_BUCKET" >/dev/null 2>&1; then
+  yc storage bucket create --name "$STATE_BUCKET" --default-storage-class standard --max-size 1073741824
+  yc storage bucket update --name "$STATE_BUCKET" --versioning versioning-enabled
+fi
+
+cat > "$OUT_DIR/backend.hcl" <<HCL
+bucket     = "$STATE_BUCKET"
+access_key = "$ACCESS_KEY"
+secret_key = "$SECRET_KEY"
+HCL
+chmod 600 "$OUT_DIR/backend.hcl"
+
+cat <<MSG
+
+Готово. Файлы с ключами (НЕ коммитить, НЕ загружать в GitHub): $OUT_DIR
+  sa-key.json        — ключ сервисного аккаунта для провайдера (sa_key_file)
+  storage-keys.json  — статический ключ для бакетов (storage_admin_access_key / secret_key)
+  backend.hcl        — параметры бэкенда state
+
+Дальше:
+  cd infra/yandex-kz
+  cp terraform.tfvars.example terraform.tfvars   # заполните cloud_id, folder_id, ssh_public_key, admin_ip_cidrs, mongo_password
+  tofu init -backend-config=$OUT_DIR/backend.hcl   # или terraform init
+  tofu plan
+MSG
diff --git a/infra/yandex-kz/scripts/deploy.sh b/infra/yandex-kz/scripts/deploy.sh
new file mode 100755
index 0000000..f900f86
--- /dev/null
+++ b/infra/yandex-kz/scripts/deploy.sh
@@ -0,0 +1,104 @@
+#!/usr/bin/env bash
+# Выкладка UmaiSense на ВМ в Yandex Cloud (kz1). Запускается НА СЕРВЕРЕ:
+#   ssh umaisense@<web_ip>
+#   /opt/umaisense/src/infra/yandex-kz/scripts/deploy.sh [git-ref]
+#
+# Первый запуск: склонируйте репозиторий в /opt/umaisense/src и положите /opt/umaisense/.env
+# (значения: tofu output -raw app_env или из консоли + JWT_SECRET + SMTP + AI).
+# Режим HTTPS: DOMAIN — доменное имя, сертификат Let's Encrypt выпускается автоматически.
+# Режим без домена: DOMAIN — IP-адрес сервера (или HTTPS=false) — только HTTP, для проверки.
+# Сборка идёт на сервере: исходники берутся из git, секреты — только из /opt/umaisense/.env.
+set -euo pipefail
+
+ROOT=/opt/umaisense
+SRC=$ROOT/src
+APP=$SRC/infra/yandex-kz/app
+cd "$ROOT"
+
+[ -f "$ROOT/.env" ] || { echo "Нет $ROOT/.env — см. DEPLOY_YANDEX_CLOUD_KZ.md"; exit 1; }
+chmod 600 "$ROOT/.env"
+. "$(dirname "$(readlink -f "$0")")/lib.sh"; load_env "$ROOT/.env"
+REF="${1:-${DEPLOY_REF:-main}}"
+: "${DOMAIN:?в .env нужен DOMAIN: доменное имя или IP-адрес сервера}"
+
+if [[ "$DOMAIN" =~ ^[0-9.]+$ ]] || [ "${HTTPS:-true}" = "false" ]; then
+  TLS=false; SCHEME=http
+  echo "!! Режим без HTTPS (DOMAIN=$DOMAIN): данные передаются без шифрования — только для проверки."
+else
+  TLS=true; SCHEME=https
+  : "${LETSENCRYPT_EMAIL:?в .env нужен LETSENCRYPT_EMAIL для сертификата}"
+fi
+
+if [ -z "${DEPLOY_REEXEC:-}" ]; then
+  echo "==> Обновляю исходники ($REF)"
+  git -C "$SRC" fetch --prune origin
+  git -C "$SRC" checkout -q "$REF"
+  git -C "$SRC" reset -q --hard "origin/$REF" 2>/dev/null || git -C "$SRC" reset -q --hard "$REF"
+  # Перезапуск уже обновлённой версии этого скрипта
+  DEPLOY_REEXEC=1 exec "$SRC/infra/yandex-kz/scripts/deploy.sh" "$REF"
+fi
+VERSION=$(git -C "$SRC" rev-parse --short HEAD)
+export APP_VERSION="$VERSION"
+
+echo "==> Конфигурация compose и nginx"
+install -m 644 "$APP/docker-compose.yml" "$ROOT/docker-compose.yml"
+mkdir -p "$ROOT/nginx/templates" "$ROOT/certs" "$ROOT/certbot/www" "$ROOT/certbot/conf"
+if [ "$TLS" = true ]; then
+  install -m 644 "$APP/nginx/templates/default.conf.template" "$ROOT/nginx/templates/default.conf.template"
+else
+  install -m 644 "$APP/nginx/http.conf.template" "$ROOT/nginx/templates/default.conf.template"
+fi
+# Корневой сертификат Yandex Cloud — для TLS-подключения к Managed MongoDB
+if [ ! -s "$ROOT/certs/root.crt" ]; then
+  curl -fsSL https://storage.yandexcloud.kz/cloud-certs/CA.pem -o "$ROOT/certs/root.crt" 2>/dev/null \
+    || curl -fsSL https://storage.yandexcloud.net/cloud-certs/CA.pem -o "$ROOT/certs/root.crt"
+fi
+
+echo "==> Проверка локальности .env"
+"$SRC/infra/yandex-kz/scripts/verify-locality.sh" --env-only
+
+echo "==> Сборка фронтенда (в контейнере Node, VITE_API_URL=/api)"
+docker run --rm -v "$SRC/umiasense-front-main":/w -w /w -e VITE_API_URL=/api node:22-alpine \
+  sh -c "npm ci --no-audit --no-fund && npm run build"
+rm -rf "$ROOT/frontend.new" && cp -r "$SRC/umiasense-front-main/dist" "$ROOT/frontend.new"
+rm -rf "$ROOT/frontend.old" && { [ -d "$ROOT/frontend" ] && mv "$ROOT/frontend" "$ROOT/frontend.old" || true; }
+mv "$ROOT/frontend.new" "$ROOT/frontend"
+
+echo "==> Сборка API ($VERSION)"
+PROFILE_ARGS=()
+[ "${USE_LOCAL_MONGO:-false}" = "true" ] && PROFILE_ARGS=(--profile mongo)
+docker compose "${PROFILE_ARGS[@]}" build api
+
+if [ "$TLS" = true ] && [ ! -f "$ROOT/certbot/conf/live/$DOMAIN/fullchain.pem" ]; then
+  echo "==> Первый выпуск сертификата Let's Encrypt для $DOMAIN (DNS уже должен указывать на этот сервер)"
+  docker rm -f umaisense-bootstrap >/dev/null 2>&1 || true
+  docker run -d --name umaisense-bootstrap -p 80:80 \
+    -v "$APP/nginx/bootstrap-http.conf":/etc/nginx/conf.d/default.conf:ro \
+    -v "$ROOT/certbot/www":/var/www/certbot:ro nginx:1.27-alpine >/dev/null
+  docker run --rm -v "$ROOT/certbot/www":/var/www/certbot -v "$ROOT/certbot/conf":/etc/letsencrypt \
+    certbot/certbot:v2.11.0 certonly --webroot -w /var/www/certbot -d "$DOMAIN" \
+    --email "$LETSENCRYPT_EMAIL" --agree-tos --no-eff-email --non-interactive
+  docker rm -f umaisense-bootstrap >/dev/null
+fi
+
+echo "==> Запуск"
+docker compose "${PROFILE_ARGS[@]}" up -d --remove-orphans
+docker compose exec -T nginx nginx -s reload >/dev/null 2>&1 || true
+
+echo "==> Ожидание готовности API"
+for i in $(seq 1 30); do
+  # Проверяем через localhost: обращение ВМ к собственному публичному IP может не проходить
+  if { [ "$TLS" = true ] && curl -fsS --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/api/health/ready"; } >/dev/null 2>&1 \
+     || { [ "$TLS" = false ] && curl -fsS "http://127.0.0.1/api/health/ready"; } >/dev/null 2>&1; then
+    echo "OK: $SCHEME://$DOMAIN работает (версия $VERSION)"
+    # Ежедневная перезагрузка nginx — чтобы подхватывались продлённые сертификаты
+    ( crontab -l 2>/dev/null | grep -v 'umaisense-nginx-reload' ; \
+      echo "17 4 * * * cd $ROOT && docker compose exec -T nginx nginx -s reload # umaisense-nginx-reload" ) | crontab -
+    docker image prune -f >/dev/null
+    exit 0
+  fi
+  sleep 5
+done
+echo "API не ответил за 150 с. Логи: docker compose logs --tail=200 api"
+echo "Откат: $0 <предыдущий коммит>"
+exit 1
diff --git a/infra/yandex-kz/scripts/lib.sh b/infra/yandex-kz/scripts/lib.sh
new file mode 100644
index 0000000..124b278
--- /dev/null
+++ b/infra/yandex-kz/scripts/lib.sh
@@ -0,0 +1,15 @@
+# Общие функции скриптов. Подключается: . "$(dirname "$0")/lib.sh"
+
+# Безопасное чтение .env: значения НЕ выполняются как команды оболочки
+# (в строке MONGO_URI есть «&», в паролях могут быть $, ` и пробелы).
+load_env() {
+  local line k v
+  while IFS= read -r line || [ -n "$line" ]; do
+    line=${line%$'\r'}
+    [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
+    [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
+    k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
+    if [[ "$v" =~ ^\"(.*)\"$ ]] || [[ "$v" =~ ^\'(.*)\'$ ]]; then v=${BASH_REMATCH[1]}; fi
+    export "$k=$v"
+  done < "$1"
+}
diff --git a/infra/yandex-kz/scripts/migrate-files.sh b/infra/yandex-kz/scripts/migrate-files.sh
new file mode 100755
index 0000000..ca5ca68
--- /dev/null
+++ b/infra/yandex-kz/scripts/migrate-files.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Перенос файлов из Cloudinary (и старой папки uploads) в бакеты Yandex Object Storage KZ.
+# Запускается НА СЕРВЕРЕ после migrate-from-atlas.sh. Использует скрипт приложения
+# src/scripts/migrate-files-to-s3.ts из стадии сборки образа (там есть devDependencies).
+#
+#   export CLOUDINARY_CLOUD_NAME=... CLOUDINARY_API_KEY=... CLOUDINARY_API_SECRET=...
+#   ./migrate-files.sh --dry-run   # пробный прогон: только список
+#   ./migrate-files.sh             # перенос (идемпотентный, можно повторять)
+#
+# CLOUDINARY_* передаются ТОЛЬКО в этот одноразовый контейнер и не попадают в .env приложения
+# (в production приложение откажется стартовать, если увидит CLOUDINARY_*).
+# Файлы в Cloudinary НЕ удаляются — владелец удаляет их вручную после проверки.
+set -euo pipefail
+
+ROOT=/opt/umaisense
+: "${CLOUDINARY_CLOUD_NAME:?}"; : "${CLOUDINARY_API_KEY:?}"; : "${CLOUDINARY_API_SECRET:?}"
+NET=host
+docker compose -f "$ROOT/docker-compose.yml" ps --services 2>/dev/null | grep -qx mongo && NET=umaisense_default
+
+docker build -q --target build -t umaisense-api-build "$ROOT/src/umaisense-back-main" >/dev/null
+docker run --rm --network "$NET" --env-file "$ROOT/.env" -e NODE_ENV=migration \
+  -e CLOUDINARY_CLOUD_NAME -e CLOUDINARY_API_KEY -e CLOUDINARY_API_SECRET \
+  -v "$ROOT/certs":/certs:ro \
+  umaisense-api-build npm run migrate:files -- "$@"
diff --git a/infra/yandex-kz/scripts/migrate-from-atlas.sh b/infra/yandex-kz/scripts/migrate-from-atlas.sh
new file mode 100755
index 0000000..3cac1af
--- /dev/null
+++ b/infra/yandex-kz/scripts/migrate-from-atlas.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Перенос базы из MongoDB Atlas в MongoDB в Yandex Cloud KZ (Managed или контейнер на ВМ).
+# Запускается НА СЕРВЕРЕ в окно работ (сайт на старом хостинге переведён в режим «только чтение»
+# или остановлен — иначе записи, сделанные во время переноса, потеряются).
+#
+#   ATLAS_URI='mongodb+srv://user:pass@cluster.mongodb.net/umai_sense' ./migrate-from-atlas.sh
+#
+# Целевая база берётся из MONGO_URI в /opt/umaisense/.env. Дамп хранится только на этой ВМ
+# (каталог 700) и удаляется в конце. Atlas НЕ удаляется — это делает владелец вручную позже.
+set -euo pipefail
+
+ROOT=/opt/umaisense
+: "${ATLAS_URI:?укажите ATLAS_URI (строка подключения к Atlas)}"
+. "$(dirname "$(readlink -f "$0")")/lib.sh"; load_env "$ROOT/.env"
+: "${MONGO_URI:?нет MONGO_URI в .env}"
+DB="${DB_NAME:-umai_sense}"
+WORK=$(mktemp -d "$ROOT/migrate.XXXXXX"); chmod 700 "$WORK"
+trap 'rm -rf "$WORK"' EXIT
+
+NET_ARGS=(--network host)
+# Если MongoDB в контейнере compose — подключаемся из той же сети
+if docker compose -f "$ROOT/docker-compose.yml" ps --services 2>/dev/null | grep -qx mongo; then
+  NET_ARGS=(--network umaisense_default)
+fi
+TOOLS=(docker run --rm "${NET_ARGS[@]}" -v "$WORK":/dump -v "$ROOT/certs":/certs:ro mongo:7.0)
+
+echo "==> Дамп из Atlas"
+"${TOOLS[@]}" mongodump --uri="$ATLAS_URI" --db="$DB" --out=/dump --gzip
+
+echo "==> Восстановление в Yandex Cloud KZ"
+"${TOOLS[@]}" mongorestore --uri="$MONGO_URI" --nsInclude="$DB.*" --gzip --drop /dump
+
+echo "==> Сверка количества документов по коллекциям"
+COUNT_JS='const d=db.getSiblingDB("'"$DB"'"); const r={}; d.getCollectionNames().sort().forEach(c=>r[c]=d.getCollection(c).countDocuments()); print(JSON.stringify(r));'
+SRC_COUNTS=$("${TOOLS[@]}" mongosh "$ATLAS_URI" --quiet --eval "$COUNT_JS")
+DST_COUNTS=$("${TOOLS[@]}" mongosh "$MONGO_URI" --quiet --eval "$COUNT_JS")
+echo "Atlas:  $SRC_COUNTS"
+echo "KZ:     $DST_COUNTS"
+if [ "$SRC_COUNTS" = "$DST_COUNTS" ]; then
+  echo "OK: количество документов совпадает."
+else
+  echo "ВНИМАНИЕ: количество отличается. Не переключайте DNS, разберитесь с расхождением."; exit 1
+fi
diff --git a/infra/yandex-kz/scripts/server-setup.sh b/infra/yandex-kz/scripts/server-setup.sh
new file mode 100755
index 0000000..7eec46a
--- /dev/null
+++ b/infra/yandex-kz/scripts/server-setup.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# Первичная настройка сервера, созданного вручную в консоли Yandex Cloud KZ (без Terraform).
+# Делает то же, что cloud-init.yaml: Docker, межсетевой экран, fail2ban, автообновления,
+# вход только по ключу, каталог /opt/umaisense.
+#
+#   sudo /opt/umaisense/src/infra/yandex-kz/scripts/server-setup.sh
+# После выполнения выйдите из SSH и зайдите снова (чтобы заработала группа docker).
+set -euo pipefail
+[ "$(id -u)" -eq 0 ] || { echo "Запустите через sudo"; exit 1; }
+APP_USER="${SUDO_USER:-umaisense}"
+
+export DEBIAN_FRONTEND=noninteractive
+apt-get update -q
+apt-get install -y -q ca-certificates curl gnupg git unattended-upgrades fail2ban ufw jq age conntrack
+
+# Docker из официального репозитория (только установка пакетов)
+if ! command -v docker >/dev/null; then
+  install -m 0755 -d /etc/apt/keyrings
+  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
+  chmod a+r /etc/apt/keyrings/docker.asc
+  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
+    > /etc/apt/sources.list.d/docker.list
+  apt-get update -q
+  apt-get install -y -q docker-ce docker-ce-cli containerd.io docker-compose-plugin
+fi
+mkdir -p /etc/docker
+cat > /etc/docker/daemon.json <<'J'
+{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "5" }, "live-restore": true }
+J
+systemctl enable docker >/dev/null && systemctl restart docker
+usermod -aG docker "$APP_USER"
+
+# SSH только по ключу
+cat > /etc/ssh/sshd_config.d/90-umaisense.conf <<'C'
+PasswordAuthentication no
+KbdInteractiveAuthentication no
+PermitRootLogin no
+MaxAuthTries 3
+C
+systemctl restart ssh
+
+# Автообновления безопасности и защита от перебора паролей
+printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > /etc/apt/apt.conf.d/20auto-upgrades
+printf '[sshd]\nenabled = true\nmaxretry = 5\nbantime = 1h\n' > /etc/fail2ban/jail.d/sshd.local
+systemctl enable --now fail2ban >/dev/null
+
+# Межсетевой экран (дополнительно к группе безопасности в облаке)
+ufw default deny incoming >/dev/null
+ufw default allow outgoing >/dev/null
+ufw allow 22/tcp >/dev/null; ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
+ufw --force enable >/dev/null
+
+timedatectl set-timezone Asia/Almaty || true
+mkdir -p /opt/umaisense/certs /opt/umaisense/certbot/www /opt/umaisense/certbot/conf
+chown -R "$APP_USER:$APP_USER" /opt/umaisense
+chmod 750 /opt/umaisense
+
+echo
+echo "Готово. Выйдите (exit) и зайдите по SSH снова, затем создайте /opt/umaisense/.env и запустите deploy.sh."
diff --git a/infra/yandex-kz/scripts/verify-locality.sh b/infra/yandex-kz/scripts/verify-locality.sh
new file mode 100755
index 0000000..cbf2e36
--- /dev/null
+++ b/infra/yandex-kz/scripts/verify-locality.sh
@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+# Проверка, что данные UmaiSense обрабатываются только в Yandex Cloud KZ.
+#   ./verify-locality.sh --env-only   — только проверка /opt/umaisense/.env (вызывается из deploy.sh)
+#   ./verify-locality.sh              — полная проверка на сервере: .env, DNS, исходящие соединения, код
+#   CAPTURE_SECONDS=600 ./verify-locality.sh   — дольше наблюдать исходящие соединения
+set -uo pipefail
+
+ROOT=/opt/umaisense
+ENV_FILE="${ENV_FILE:-$ROOT/.env}"
+SRC="${SRC:-$ROOT/src}"
+FAIL=0
+ok()   { echo "  [OK]   $*"; }
+warn() { echo "  [WARN] $*"; }
+bad()  { echo "  [FAIL] $*"; FAIL=1; }
+
+host_of() { echo "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[/?].*$##' | tr ',' '\n' | sed -E 's#:[0-9]+$##'; }
+is_local() {
+  case "$1" in
+    *.yandexcloud.kz|yandexcloud.kz|localhost|127.*|10.*|192.168.*|mongo|api|nginx) return 0 ;;
+    172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
+  esac
+  for h in $(echo "${LOCALITY_ALLOWED_HOSTS:-}" | tr ',' ' '); do [ "$1" = "$h" ] && return 0; done
+  return 1
+}
+
+echo "== 1. Переменные окружения ($ENV_FILE)"
+if [ -f "$ENV_FILE" ]; then
+  . "$(dirname "$(readlink -f "$0")")/lib.sh"; load_env "$ENV_FILE"
+  for v in MONGO_URI S3_ENDPOINT SMTP_HOST AI_YANDEX_BASE_URL AI_LOCAL_BASE_URL; do
+    val="${!v:-}"; [ -z "$val" ] && continue
+    for h in $(host_of "$val"); do
+      if is_local "$h"; then ok "$v → $h"; else bad "$v → $h (не Yandex Cloud KZ и не в LOCALITY_ALLOWED_HOSTS)"; fi
+    done
+  done
+  grep -qE '^CLOUDINARY_' "$ENV_FILE" && bad "в .env есть CLOUDINARY_* — удалите"
+  grep -qE 'mongodb\.net' "$ENV_FILE" && bad "в .env есть адрес MongoDB Atlas"
+  AI="${AI_SCREENING_PROVIDER:-off}"
+  if [ "$AI" = "openai" ]; then
+    if [ "${ALLOW_FOREIGN_AI:-}" = "true" ]; then
+      warn "ИИ = OpenAI (США): обезличенные данные уходят за рубеж ТОЛЬКО с согласием родителя cross_border (ALLOW_FOREIGN_AI=true)"
+    else
+      bad "AI_SCREENING_PROVIDER=openai без ALLOW_FOREIGN_AI=true — сервер не запустится"
+    fi
+  else
+    ok "ИИ = $AI"
+  fi
+else
+  bad "нет файла $ENV_FILE"
+fi
+[ "${1:-}" = "--env-only" ] && exit $FAIL
+
+echo "== 2. DNS домена"
+if [ -n "${DOMAIN:-}" ]; then
+  IP=$(getent ahostsv4 "$DOMAIN" | awk 'NR==1{print $1}')
+  MY=$(curl -fsS -m 5 http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)
+  if [ -n "$IP" ] && [ "$IP" = "$MY" ]; then ok "$DOMAIN → $IP (этот сервер)"; else warn "$DOMAIN → ${IP:-нет} , IP сервера ${MY:-?}"; fi
+fi
+
+echo "== 3. Исходящие соединения за ${CAPTURE_SECONDS:-120} с (кроме внутренней сети)"
+END=$((SECONDS + ${CAPTURE_SECONDS:-120})); declare -A SEEN
+while [ $SECONDS -lt $END ]; do
+  while read -r dst; do SEEN["$dst"]=1; done < <(sudo conntrack -L -p tcp 2>/dev/null | grep -oE 'dst=[0-9.]+ sport=[0-9]+ dport=[0-9]+' | awk '{print $1":"$3}' | sed 's/dst=//; s/dport=//' | sort -u)
+  sleep 5
+done
+for d in "${!SEEN[@]}"; do
+  ip=${d%%:*}; port=${d##*:}
+  case "$ip" in 10.*|127.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|192.168.*) continue ;; esac
+  name=$(getent hosts "$ip" | awk '{print $2}')
+  echo "  → $ip:$port ${name:-(нет PTR)}"
+done
+echo "  Сверьте адреса: ожидаются Yandex Cloud KZ (storage/mdb/api.yandexcloud.kz), SMTP-провайдер РК,"
+echo "  репозитории пакетов (только при обновлении) и api.openai.com — если ИИ = OpenAI по флагу."
+
+echo "== 4. Код: ссылки на зарубежные сервисы"
+if [ -d "$SRC" ]; then
+  HITS=$(grep -rnEi 'vercel\.app|netlify|mongodb\.net|res\.cloudinary|smtp\.gmail|fonts\.googleapis|fonts\.gstatic|googletagmanager|google-analytics' \
+    "$SRC/umaisense-back-main/src" "$SRC/umiasense-front-main/src" "$SRC/umiasense-front-main/index.html" 2>/dev/null \
+    | grep -v 'scripts/\|isForeign\|mongodb\\\.net\|res\\\.cloudinary\|env\.ts' || true)
+  if [ -n "$HITS" ]; then warn "найдены упоминания (проверьте, не используются ли в рабочем коде):"; echo "$HITS" | head -20
+  else ok "рабочий код не обращается к Vercel/Netlify/Atlas/Cloudinary/Gmail/Google Fonts"; fi
+fi
+
+echo
+[ $FAIL -eq 0 ] && echo "Итог: нарушений не найдено." || echo "Итог: есть нарушения (FAIL) — исправьте до переключения DNS."
+exit $FAIL
diff --git a/infra/yandex-kz/security.tf b/infra/yandex-kz/security.tf
new file mode 100644
index 0000000..b4b7f78
--- /dev/null
+++ b/infra/yandex-kz/security.tf
@@ -0,0 +1,87 @@
+# Сервер приложения: снаружи открыты только 80/443 (сайт) и 22 (SSH только с IP администратора)
+resource "yandex_vpc_security_group" "web" {
+  name       = "umaisense-web"
+  network_id = yandex_vpc_network.main.id
+
+  ingress {
+    description    = "HTTP (редирект на HTTPS, выпуск сертификата Let's Encrypt)"
+    protocol       = "TCP"
+    port           = 80
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  ingress {
+    description    = "HTTPS"
+    protocol       = "TCP"
+    port           = 443
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  ingress {
+    description    = "SSH — только администратор"
+    protocol       = "TCP"
+    port           = 22
+    v4_cidr_blocks = var.admin_ip_cidrs
+  }
+
+  # Исходящий трафик. Внутри облака — всё; наружу — только HTTPS/DNS/NTP/SMTP.
+  # HTTPS наружу нужен для: Object Storage KZ (storage.yandexcloud.kz), обновлений ОС и Docker,
+  # Let's Encrypt и — пока включён ALLOW_FOREIGN_AI — для OpenAI.
+  # Персональные данные уходят только туда, куда их отправляет код; это ограничено проверкой
+  # при старте (src/utils/env.ts) и контролируется скриптом scripts/verify-locality.sh.
+  egress {
+    description    = "Внутренняя сеть"
+    protocol       = "ANY"
+    v4_cidr_blocks = ["10.20.0.0/24"]
+  }
+
+  egress {
+    description    = "HTTPS"
+    protocol       = "TCP"
+    port           = 443
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  egress {
+    description    = "HTTP (репозитории пакетов Ubuntu)"
+    protocol       = "TCP"
+    port           = 80
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  egress {
+    description    = "DNS"
+    protocol       = "UDP"
+    port           = 53
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  egress {
+    description    = "NTP"
+    protocol       = "UDP"
+    port           = 123
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+
+  egress {
+    description    = "SMTP submission (почтовый провайдер в РК)"
+    protocol       = "TCP"
+    from_port      = 465
+    to_port        = 587
+    v4_cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+# База данных: доступ только с сервера приложения, порт Managed MongoDB — 27018
+resource "yandex_vpc_security_group" "mongo" {
+  count      = var.use_managed_mongodb ? 1 : 0
+  name       = "umaisense-mongo"
+  network_id = yandex_vpc_network.main.id
+
+  ingress {
+    description       = "MongoDB только с сервера приложения"
+    protocol          = "TCP"
+    port              = 27018
+    security_group_id = yandex_vpc_security_group.web.id
+  }
+}
diff --git a/infra/yandex-kz/storage.tf b/infra/yandex-kz/storage.tf
new file mode 100644
index 0000000..de47af5
--- /dev/null
+++ b/infra/yandex-kz/storage.tf
@@ -0,0 +1,98 @@
+# ─── Бакеты Object Storage (регион Казахстан) ──────────────────────────────────
+
+# Закрытый бакет медицинских документов: доступ только по подписанной ссылке на 5 минут,
+# шифрование KMS, версионирование (защита от случайного удаления), CORS — только свой домен.
+resource "yandex_storage_bucket" "documents" {
+  bucket    = "${var.bucket_prefix}-documents"
+  folder_id = var.folder_id
+
+  anonymous_access_flags {
+    read        = false
+    list        = false
+    config_read = false
+  }
+
+  versioning {
+    enabled = true
+  }
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        kms_master_key_id = yandex_kms_symmetric_key.data.id
+        sse_algorithm     = "aws:kms"
+      }
+    }
+  }
+
+  # Браузер загружает и открывает документы напрямую по подписанной ссылке
+  cors_rule {
+    allowed_methods = ["PUT", "GET", "HEAD"]
+    allowed_origins = ["https://${var.domain}"]
+    allowed_headers = ["*"]
+    expose_headers  = ["ETag"]
+    max_age_seconds = 3600
+  }
+
+  lifecycle_rule {
+    id                                     = "cleanup"
+    enabled                                = true
+    abort_incomplete_multipart_upload_days = 1
+
+    # Удалённые документы (старые версии) окончательно стираются через 30 дней
+    noncurrent_version_expiration {
+      days = 30
+    }
+  }
+}
+
+# Картинки интерфейса (фото профилей, обложки): чтение без авторизации, но без списка файлов.
+# Раздаются через nginx того же домена: https://app.umaisense.kz/media/...
+resource "yandex_storage_bucket" "public" {
+  bucket    = "${var.bucket_prefix}-public"
+  folder_id = var.folder_id
+
+  anonymous_access_flags {
+    read        = true
+    list        = false
+    config_read = false
+  }
+}
+
+# Бэкапы базы: закрыто, шифрование KMS, версионирование, автоудаление по сроку хранения
+resource "yandex_storage_bucket" "backups" {
+  bucket    = "${var.bucket_prefix}-backups"
+  folder_id = var.folder_id
+
+  anonymous_access_flags {
+    read        = false
+    list        = false
+    config_read = false
+  }
+
+  versioning {
+    enabled = true
+  }
+
+  server_side_encryption_configuration {
+    rule {
+      apply_server_side_encryption_by_default {
+        kms_master_key_id = yandex_kms_symmetric_key.data.id
+        sse_algorithm     = "aws:kms"
+      }
+    }
+  }
+
+  lifecycle_rule {
+    id      = "retention"
+    enabled = true
+
+    expiration {
+      days = var.backup_retention_days
+    }
+
+    noncurrent_version_expiration {
+      days = 7
+    }
+  }
+}
