{
  "buildCommand": "npm install --prefix umiasense-front-main && npm run build --prefix umiasense-front-main",
  "outputDirectory": "umiasense-front-main/dist",
  "installCommand": "npm install --prefix umaisense-back-main",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "umaisense-back-main/{assets/**,node_modules/@tesseract.js-data/**,node_modules/tesseract.js/**,node_modules/tesseract.js-core/**}"
    }
  }
}
