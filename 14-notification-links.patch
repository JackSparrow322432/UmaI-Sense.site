@@ -1,13 +1,46 @@
 import { Response } from 'express';
 import { AuthRequest } from '../types';
 import Notification from '../models/Notification';
+import DiaryEntry from '../models/DiaryEntry';
+import Recommendation from '../models/Recommendation';
+
+/**
+ * Куда ведёт уведомление при нажатии. Для записей дневника и ИИ-советов нужен id ребёнка —
+ * берём его из связанной записи одним запросом на тип.
+ */
+const linkFor = (n: any, role: string | undefined, childOf: Map<string, string>): string | null => {
+  const id = n.relatedId ? String(n.relatedId) : '';
+  switch (n.type) {
+    case 'new_task':
+    case 'task_rated':        return id ? (role === 'admin' ? `/admin/tasks/${id}/submissions` : `/tasks/${id}`) : '/tasks';
+    case 'new_article':       return id ? `/articles/${id}` : '/articles';
+    case 'enrollment_update': return role === 'admin' ? '/admin/requests' : '/requests';
+    case 'trainer_assigned':
+    case 'session_cancelled': return role === 'admin' ? '/admin/schedule' : '/schedule';
+    case 'invite_accepted':   return id ? `/children/${id}` : '/children';
+    case 'diary_entry':       return childOf.get(id) ? `/children/${childOf.get(id)}/diary` : '/children';
+    case 'ai_recommendation': return childOf.get(id) ? `/children/${childOf.get(id)}/recommendations` : '/children';
+    case 'emotion_reminder':  return '/children';
+    default:                  return null;
+  }
+};
 
 export const getNotifications = async (req: AuthRequest, res: Response): Promise<void> => {
   try {
     const notifications = await Notification.find({ userId: req.user!.id })
       .sort({ createdAt: -1 })
-      .limit(50);
-    res.json(notifications);
+      .limit(50)
+      .lean();
+
+    const ids = (t: string) => notifications.filter((n: any) => n.type === t && n.relatedId).map((n: any) => n.relatedId);
+    const [diary, recs] = await Promise.all([
+      DiaryEntry.find({ _id: { $in: ids('diary_entry') } }).select('childId').lean(),
+      Recommendation.find({ _id: { $in: ids('ai_recommendation') } }).select('childId').lean(),
+    ]);
+    const childOf = new Map<string, string>();
+    for (const r of [...diary, ...recs] as any[]) childOf.set(String(r._id), String(r.childId));
+
+    res.json(notifications.map((n: any) => ({ ...n, link: linkFor(n, req.user?.role, childOf) })));
   } catch {
     res.status(500).json({ message: 'Server error' });
   }
