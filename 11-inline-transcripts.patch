@@ -144,19 +144,85 @@ export function TranscriptModal({ childId, doc, onClose }: {
 
 // ─── Документы ───────────────────────────────────────────────────────────────
 
+type AdminDoc = DocumentItem & {
+  extractedText?: string;
+  extractTruncated?: boolean;
+  extractError?: string;
+  extractStatus?: 'done' | 'pending';
+};
+
+/** Расшифровка прямо под документом: свёрнута до ~8 строк, раскрывается целиком */
+function InlineTranscript({ d, onFull }: { d: AdminDoc; onFull: () => void }) {
+  const [expanded, setExpanded] = useState(false);
+  const text = d.extractedText || '';
+  const long = text.length > 600 || text.split('\n').length > 8;
+
+  if (d.extractStatus === 'pending') {
+    return (
+      <div className="mt-3 flex items-center gap-2 text-xs text-gray-400 bg-gray-50 rounded-lg px-3 py-2.5">
+        <div className="w-3.5 h-3.5 border-2 border-[#E07628] border-t-transparent rounded-full animate-spin" />
+        Расшифровываем документ… текст появится здесь автоматически.
+      </div>
+    );
+  }
+  if (!text) {
+    return (
+      <p className="mt-3 text-xs text-gray-400 bg-gray-50 rounded-lg px-3 py-2.5">
+        {d.extractError || 'Текст в документе не найден.'}
+      </p>
+    );
+  }
+  return (
+    <div className="mt-3 rounded-lg border border-gray-100 bg-gray-50/60">
+      <div className="px-3 pt-2.5 flex items-center gap-2">
+        <span className="text-[11px] font-semibold uppercase tracking-wide text-gray-500">Расшифровка</span>
+        {d.extractMethod && METHOD[d.extractMethod] && (
+          <span className="text-[10px] text-gray-400">· {METHOD[d.extractMethod]}</span>
+        )}
+      </div>
+      <pre className={`px-3 pt-1.5 pb-2.5 whitespace-pre-wrap font-sans text-[13px] leading-relaxed text-gray-700 ${!expanded && long ? 'max-h-40 overflow-hidden [mask-image:linear-gradient(to_bottom,black_70%,transparent)]' : ''}`}>
+        {text}
+      </pre>
+      {(long || d.extractTruncated) && (
+        <div className="px-3 pb-2.5 flex gap-4">
+          {long && (
+            <button onClick={() => setExpanded((v) => !v)} className="text-xs font-semibold text-[#E07628] hover:underline">
+              {expanded ? 'Свернуть' : 'Показать полностью'}
+            </button>
+          )}
+          {d.extractTruncated && (
+            <button onClick={onFull} className="text-xs font-semibold text-gray-500 hover:underline">Весь текст (длинный документ)</button>
+          )}
+        </div>
+      )}
+      {d.extractMethod === 'ocr' && (
+        <p className="px-3 pb-2.5 text-[10px] text-amber-600">Распознано со скана автоматически — сверяйтесь с оригиналом.</p>
+      )}
+    </div>
+  );
+}
+
 export function ChildDocumentsAdmin({ childId }: { childId: string }) {
-  const [docs, setDocs] = useState<DocumentItem[] | null>(null);
+  const [docs, setDocs] = useState<AdminDoc[] | null>(null);
   const [transcript, setTranscript] = useState<{ _id: string; fileName: string } | null>(null);
   const open = useOpenDocument(childId);
 
+  const load = () => adminApi.getChildDocuments(childId).then(({ data }) => setDocs(data as AdminDoc[])).catch(() => setDocs((v) => v ?? []));
+  useEffect(() => { load(); }, [childId]);
+
+  // Пока какой-то документ расшифровывается — обновляем список раз в 6 секунд (до 3 минут)
+  const pending = (docs || []).some((d) => d.extractStatus === 'pending');
   useEffect(() => {
-    adminApi.getChildDocuments(childId).then(({ data }) => setDocs(data)).catch(() => setDocs([]));
-  }, [childId]);
+    if (!pending) return;
+    let n = 0;
+    const t = setInterval(() => { if (++n > 30) clearInterval(t); else load(); }, 6000);
+    return () => clearInterval(t);
+  }, [pending, childId]);
 
   return (
     <div>
-      <p className="text-xs font-medium text-gray-500 mb-3">Документы{docs ? ` · ${docs.length}` : ''}</p>
-      <div className="bg-white rounded-xl border border-gray-200 divide-y divide-gray-50">
+      <p className="text-xs font-medium text-gray-500 mb-3">Документы и их расшифровка{docs ? ` · ${docs.length}` : ''}</p>
+      <div className="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
         {docs === null ? (
           <p className="px-5 py-6 text-sm text-gray-400">Загрузка…</p>
         ) : docs.length === 0 ? (
@@ -166,28 +232,27 @@ export function ChildDocumentsAdmin({ childId }: { childId: string }) {
