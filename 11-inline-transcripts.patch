 import { logAccess } from '../utils/audit';
 import { buildChildDossier } from '../utils/childDossierPdf';
 import DocumentModel from '../models/Document';
-import { getDocumentText } from '../utils/documentText';
+import { getDocumentText, queueExtraction } from '../utils/documentText';
 import { getDownloadUrl as storageDownloadUrl, isProviderAvailable, StorageProvider } from '../utils/documentStorage';
 
 // GET /api/admin/users — все пользователи, включая администраторов
@@ -119,15 +119,40 @@ export const getChildAudit = async (req: AuthRequest, res: Response): Promise<vo
   }
 };
 
-// GET /api/admin/children/:childId/documents — все документы ребёнка
+// GET /api/admin/children/:childId/documents — все документы ребёнка вместе с расшифровкой.
+// Документы без расшифровки ставятся в очередь распознавания (результат появится через минуту).
+const INLINE_TEXT_LIMIT = 20_000;
 export const listChildDocuments = async (req: AuthRequest, res: Response): Promise<void> => {
   try {
     const docs = await DocumentModel.find({ childId: req.params['childId'], status: { $ne: 'uploading' } })
-      .select('-storageKey -storageProvider -uploadExpiresAt')
+      .select('-storageKey -storageProvider -uploadExpiresAt +extractedText')
       .populate('uploadedBy', 'name email role')
       .sort({ createdAt: -1 })
       .lean();
-    res.json(docs);
+    const out = docs.map((d: any) => {
+      const ready = !!d.extractedAt;
+      if (!ready) queueExtraction(String(d._id));
+      const text: string = d.extractedText || '';
+      return {
+        ...d,
+        extractedText: text.slice(0, INLINE_TEXT_LIMIT),
+        extractTruncated: text.length > INLINE_TEXT_LIMIT,
+        extractStatus: ready ? 'done' : 'pending',
+      };
+    });
+    // Текст документов показан на странице — фиксируем в журнале доступа
+    // (не чаще раза в 30 минут на документ, чтобы обновление страницы не засоряло журнал)
+    const shown = out.filter((d: any) => d.extractedText);
+    if (shown.length) {
+      const recent = await AuditLog.find({
+        userId: req.user?.id, action: 'document.view', 'meta.transcript': true,
+        documentId: { $in: shown.map((d: any) => d._id) }, createdAt: { $gte: new Date(Date.now() - 30 * 60 * 1000) },
+      }).select('documentId').lean();
+      const seen = new Set(recent.map((r: any) => String(r.documentId)));
+      await Promise.all(shown.filter((d: any) => !seen.has(String(d._id))).map((d: any) =>
+        logAccess(req, { action: 'document.view', childId: d.childId, documentId: d._id, meta: { transcript: true } })));
+    }
+    res.json(out);
   } catch {
     res.status(500).json({ message: 'Server error' });
   }
